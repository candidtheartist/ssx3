+
+void GSThreadedBackend::TextureFlush()
+{
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+    beginCommand(lock, CommandKind::TextureFlush);
+    endCommand(lock);
+}
