+namespace
+{
+    constexpr const char *kGeneratedSignature =
+        "uint32_t b%zu(VU1Interpreter &vu, const void *runtimePairs, uint8_t *d, uint32_t ds, GS &gs, PS2Memory *m, "
+        "bool &ended)";
+
+    // One block as straight-line code: the pairs runCompiled's loop would
+    // step through, with each fast pair's fields as constants.
+    void writeGeneratedBlock(std::FILE *out, size_t index, const VU1CompiledAccess::Code::Block &block)
+    {
+        using Pair = VU1CompiledAccess::Pair;
+        std::fprintf(out, kGeneratedSignature, index);
+        std::fprintf(out, "\n{\n    const P *pairs = static_cast<const P *>(runtimePairs);\n    (void)pairs;\n"
+                          "    (void)ended;\n");
+        for (size_t i = 0; i < block.pairs.size(); ++i)
+        {
+            const Pair &p = block.pairs[i];
+            // On a stop the interpreter takes over after this pair; when a
+            // control pair ended the program, the caller wants its index.
+            char ret[96];
+            if (p.control)
+                std::snprintf(ret, sizeof(ret), "ended ? %zuu : (%zuu | kGeneratedCut)", i, i + 1);
+            else
+                std::snprintf(ret, sizeof(ret), "%zuu | kGeneratedCut", i + 1);
+            if (p.slow)
+            {
+                std::fprintf(out, "    if (!A::step(vu, pairs[%zu], d, ds, gs, m, ended))\n        return %s;\n", i, ret);
+                continue;
+            }
+            std::fprintf(out,
+                         "    static constexpr P p%zu{.pc = 0x%x, .vfLandBy = %u, .stall = %u, .simple = %d, .control = %d, "
+                         ".readsFlags = %d, .queuesEvent = %d, .startsXgkick = %d, .keepDeclared = %d, .slow = %d, "
+                         ".special = %d, .upperOp = C::UpperOp(%u), .lowerOp = C::LowerOp(%u), .writtenVi = %u, "
+                         ".viLatency = %u, .delaysBranchRead = %d, .shownCount = %u, .shownReg = {%u, %u}, "
+                         ".shownComponents = {%u, %u}, .vfS = %u, .vfT = %u, .viS = %u, .viT = %u, .viD = %u, "
+                         ".dest = %u, .immediate = %d, .branchTarget = 0x%x, .fmac = {%u, %u, %u, %u, %u, %u, %d}, "
+                         ".upper = 0x%08xu, .lower = 0x%08xu, .lowerFirst = %d, .eBit = %d};\n"
+                         "    if (!A::step(vu, p%zu, d, ds, gs, m, ended))\n        return %s;\n",
+                         i, p.pc, p.vfLandBy, p.stall, p.simple, p.control, p.readsFlags, p.queuesEvent,
+                         p.startsXgkick, p.keepDeclared, p.slow, p.special, static_cast<unsigned>(p.upperOp),
+                         static_cast<unsigned>(p.lowerOp), p.writtenVi, p.viLatency, p.delaysBranchRead,
+                         p.shownCount, p.shownReg[0], p.shownReg[1], p.shownComponents[0], p.shownComponents[1],
+                         p.vfS, p.vfT, p.viS, p.viT, p.viD, p.dest, p.immediate, p.branchTarget, p.fmac.form,
+                         p.fmac.rhs, p.fmac.fs, p.fmac.ft, p.fmac.fd, p.fmac.components, p.fmac.toAcc, p.upper,
+                         p.lower, p.lowerFirst, p.eBit, i, ret);
+        }
+        std::fprintf(out, "    return %zuu;\n}\n\n", block.pairs.size());
+    }
+}
+
+size_t VU1CompiledAccess::generate(const std::vector<std::vector<uint8_t>> &images, std::FILE *list,
+                                   const std::vector<std::FILE *> &shards, size_t &listed)
+{
+    std::vector<ListedBlock> wanted;
+    std::set<ListedKey> seen;
+    char line[1024];
+    while (std::fgets(line, sizeof(line), list))
+    {
+        ListedBlock block;
+        if (line[0] != '#' && parseListedBlock(line, block) &&
+            seen.insert(ListedKey{block.code, block.pc, timingKey(block.timing)}).second)
+            wanted.push_back(block);
+    }
+    listed = wanted.size();
+
+    // Each image compiled the way runCompiled would compile it.
+    g_generating = true;
+    VU1Interpreter vu;
+    std::vector<std::unique_ptr<Code>> codes;
+    for (const std::vector<uint8_t> &image : images)
+    {
+        auto code = std::make_unique<Code>();
+        code->image = image;
+        code->image.resize(PS2_VU1_CODE_SIZE);
+        code->decoded.resize(VU1Interpreter::kMaxDecodedPairs);
+        for (uint32_t i = 0; i < VU1Interpreter::kMaxDecodedPairs; ++i)
+            code->decoded[i] = vu.decodeInstructionPair(code->image.data(), i * 8u);
+        code->intern(VuTiming{});
+        codes.push_back(std::move(code));
+    }
+
+    struct Found
+    {
+        const Code::Block *block;
+        uint32_t pc;
+        uint64_t timing;
+    };
+    std::vector<Found> found;
+    for (const ListedBlock &want : wanted)
+    {
+        const uint32_t pc = want.pc & 0xFFFFu;
+        const bool delaySlot = (want.pc & 0x10000u) != 0u;
+        if (pc + 8u > PS2_VU1_CODE_SIZE || (pc & 7u) != 0u)
+            continue;
+        for (const std::unique_ptr<Code> &code : codes)
+        {
+            const Code::Block *block = code->find(code->decoded.data(), PS2_VU1_CODE_SIZE, pc,
+                                                  code->intern(want.timing), delaySlot);
+            if (!block->pairs.empty() && block->code == want.code)
+            {
+                found.push_back(Found{block, want.pc, timingKey(want.timing)});
+                break;
+            }
+        }
+    }
+
+    g_generating = false;
+
+    static constexpr const char *kHeader =
+        "// Generated at build time from the VU1 block list and the game's VU1 code. Do not edit.\n"
+        "#include \"vu/ps2_vu1_compiled.h\"\n\nnamespace ps2vu1gen\n{\n"
+        "using A = VU1CompiledAccess;\nusing P = A::Pair;\nusing C = A::Code;\n\n";
+    for (std::FILE *shard : shards)
+        std::fprintf(shard, "%s", kHeader);
+    for (size_t i = 0; i < found.size(); ++i)
+        writeGeneratedBlock(shards[i % shards.size()], i, *found[i].block);
+    for (std::FILE *shard : shards)
+        if (shard != shards[0])
+            std::fprintf(shard, "}\n");
+
+    std::FILE *table = shards[0];
+    for (size_t i = 0; i < found.size(); ++i)
+    {
+        std::fprintf(table, kGeneratedSignature, i);
+        std::fprintf(table, ";\n");
+    }
+    if (found.empty())
+    {
+        std::fprintf(table, "}\n");
+        return 0;
+    }
+    std::fprintf(table, "\nconst VU1GeneratedBlock kBlocks[] = {\n");
+    for (size_t i = 0; i < found.size(); ++i)
+        std::fprintf(table, "    {0x%016llxull, 0x%x, 0x%016llxull, b%zu},\n",
+                     static_cast<unsigned long long>(found[i].block->code), found[i].pc,
+                     static_cast<unsigned long long>(found[i].timing), i);
+    std::fprintf(table, "};\n\n// Registered before main, so before any VU1 program is compiled.\n"
+                        "[[maybe_unused]] const bool kRegistered = (registerGeneratedBlocks(kBlocks, sizeof(kBlocks) / sizeof(kBlocks[0])), "
+                        "true);\n}\n");
+    return found.size();
+}
+
+size_t VU1CompiledAccess::generatedBlocks(const VU1Interpreter &vu)
+{
+    if (!vu.m_compiled || !vu.m_compiled->current)
+        return 0;
+    size_t count = 0;
+    for (const auto &[key, block] : vu.m_compiled->current->blocks)
+        count += block->generated != nullptr ? 1u : 0u;
+    return count;
+}
