@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <thread>
+
+// A joinable host thread with a stack of at least stackBytes. std::thread leaves the stack size to the
+// platform: 8 MB on Linux, but the executable's default on Windows (2 MB with MinGW, 1 MB with MSVC).
+class Ps2HostThread
+{
+public:
+    Ps2HostThread(size_t stackBytes, std::function<void()> body);
+    ~Ps2HostThread();
+    Ps2HostThread(const Ps2HostThread &) = delete;
+    Ps2HostThread &operator=(const Ps2HostThread &) = delete;
+
+    bool joinable() const;
+    void join();
+
+private:
+#if defined(_WIN32)
+    void *m_handle = nullptr;
+#else
+    std::thread m_thread;
+#endif
+};
