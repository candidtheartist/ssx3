+    // Enough for a few frames of SSX 3's draws; beyond it the EE waits for the GS.
+    constexpr uint64_t kMaxPendingCommands = 16384u;
+    // When the queue is full, the EE waits until this many commands have been run, so
+    // the workers don't wake it for every one.
+    constexpr uint64_t kRefillCommands = 1024u;
+    // A presentation request never waits for room, and a new one can be queued as soon
+    // as the last one has run but before the workers have moved past it: at most two
+    // commands beyond the limit.
+    constexpr uint64_t kRingSize = kMaxPendingCommands + 4u;
+    // Idle workers are woken once this many commands are queued, rather than for each
+    // one: a race can queue 30,000 draws a frame, and waking several threads costs the
+    // EE a system call, and the lock it then waits for, each time.
+    constexpr uint64_t kWakeBatch = 32u;
+    // Primitives a Submit takes at most, and room for the runs of a full queue's worth of
+    // them (each primitive's slot is reused once every worker has run its command).
+    constexpr uint64_t kMaxRunLength = 64u;
+    constexpr uint64_t kRunPrimitives = 65536u;
+
+    bool noPages(const std::array<uint64_t, 8> &pages)
+    {
+        for (uint64_t word : pages)
+        {
+            if (word != 0u)
