+
+// What execCompiledPair does after a control pair: the pc moves on, and a
+// branch or E bit due takes effect.
+__attribute__((always_inline)) inline void VU1Interpreter::finishControlPair(bool eBit, bool &programEnded)
+{
+    uint32_t nextPc = m_state.pc + 8u;
+    if (nextPc >= m_compiledCodeSize)
+        nextPc = 0u;
+    m_state.pc = nextPc;
+    if (m_state.branchPending)
+    {
+        if (m_state.branchDelay == 0u)
+        {
+            m_state.pc = m_state.branchTarget & microAddressMask();
+            m_state.branchPending = false;
+        }
+        else
+            --m_state.branchDelay;
+    }
+    // D and T bits are off whenever this runs.
+    if (m_state.haltAfterDelaySlot)
+    {
+        m_state.stoppedByD = m_pendingHaltD;
+        m_state.stoppedByT = m_pendingHaltT;
+        programEnded = true;
+    }
+    else if (m_state.ebit)
+        programEnded = true;
+    else if (eBit)
+        m_state.ebit = true;
+}
+
+// Keeps the old values of lanes that get a result with none on its way.
+__attribute__((always_inline)) inline void VU1Interpreter::saveShownValues(const void *pairPointer)
+{
+    const CompiledCode::Pair &pair = *static_cast<const CompiledCode::Pair *>(pairPointer);
+    for (uint32_t slot = 0; slot < pair.shownCount; ++slot)
+    {
+        const uint8_t reg = pair.shownReg[slot];
+        const __m128i componentBits = _mm_set_epi32(8, 4, 2, 1);
+        const __m128 components = _mm_castsi128_ps(
+            _mm_cmpeq_epi32(_mm_and_si128(_mm_set1_epi32(pair.shownComponents[slot]), componentBits), componentBits));
+        float *shown = &m_vfShown[reg * 4u];
+        _mm_storeu_ps(shown, _mm_blendv_ps(_mm_loadu_ps(shown), _mm_loadu_ps(m_state.vf[reg]), components));
+    }
+}
+
+// execCompiledPair for the common pairs: simple, not a control pair, and
+// with no op that needs its writes trimmed.
+__attribute__((always_inline)) inline void VU1Interpreter::execFastPair(const void *pairPointer, uint8_t *vuData,
+                                                                        uint32_t dataSize, GS &gs, PS2Memory *memory)
+{
+    const CompiledCode::Pair &pair = *static_cast<const CompiledCode::Pair *>(pairPointer);
+    if (pair.shownCount != 0u)
+        saveShownValues(pairPointer);
+    const uint8_t writtenVi = pair.writtenVi;
+    int32_t *vi = m_state.vi;
+    const int32_t oldVi = vi[writtenVi];
+    execSimpleOps(pairPointer, vuData, dataSize, gs, memory);
+    m_viBranchBackupValid = false;
+    if (writtenVi != 0u)
+    {
+        if (pair.viLatency <= 1u)
+        {
+            vi[writtenVi] = static_cast<int16_t>(vi[writtenVi]);
+            m_viLatestWrite[writtenVi] = ++m_nextWriteSequence;
+        }
+        else
+        {
+            const int32_t newVi = vi[writtenVi];
+            vi[writtenVi] = oldVi;
+            queueViWrite(writtenVi, newVi, pair.viLatency);
+        }
+        if (pair.delaysBranchRead)
+            recordViWriteForBranch(writtenVi, oldVi);
+    }
+    _mm_storeu_ps(m_state.vf[0], _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f));
+    vi[0] = 0;
+}
+
+struct VU1CompiledAccess
+{
+    using Code = VU1Interpreter::CompiledCode;
+    using Pair = Code::Pair;
+
+    // One pair, as runCompiled's loop runs it. False when the program ended
+    // or a stop was requested, and the interpreter takes over.
+    static __attribute__((always_inline)) inline bool step(VU1Interpreter &vu, const Pair &pair, uint8_t *vuData,
+                                                           uint32_t dataSize, GS &gs, PS2Memory *memory,
+                                                           bool &programEnded)
+    {
+        vu.m_cycle += pair.stall;
+        if (vu.m_cycle >= vu.m_compiledNextEvent)
+            vu.commitCompiledEvents();
+        if (pair.special && pair.readsFlags)
+            vu.commitFlagsUpTo(vu.m_cycle);
+        if (pair.slow)
+            vu.execCompiledPair(&pair, vuData, dataSize, gs, memory, programEnded);
+        else
+        {
+            if (pair.control)
+                vu.m_state.pc = pair.pc;
+            vu.execFastPair(&pair, vuData, dataSize, gs, memory);
+            if (pair.control)
+                vu.finishControlPair(pair.eBit, programEnded);
+        }
+        if (pair.special)
+        {
+            if (pair.startsXgkick)
+                vu.m_xgkickProgressCycle = vu.m_cycle;
+            if (pair.queuesEvent)
+                vu.m_compiledNextEvent = std::min(vu.m_nextScalarCommit, vu.m_compiledNextVi);
+        }
+        ++vu.m_cycle;
+        if (pair.control && programEnded)
+            return false;
+        // A bad GIFtag stops the unit before the next pair (run() checks
+        // m_stopRequested there), so PATH1 keeps up while it moves.
+        if (vu.m_xgkick.active)
+            vu.catchUpXgkick();
+        return !vu.m_stopRequested;
+    }
+
+    // Compiles the blocks a block list names from whichever of images holds
+    // each one (the same pairs at the same pcs), and writes them as C++ across
+    // shards; the first shard also registers them (registerGeneratedBlocks).
+    // A listed block no image holds is left to the executor. Returns how many
+    // listed blocks were written; listed is how many the list named.
+    static size_t generate(const std::vector<std::vector<uint8_t>> &images, std::FILE *list,
+                           const std::vector<std::FILE *> &shards, size_t &listed);
+    // How many of the blocks compiled for the code image vu last ran have
+    // generated code.
+    static size_t generatedBlocks(const VU1Interpreter &vu);
+};
