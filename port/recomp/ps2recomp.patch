+    bool IopRpcBridge::deliverSifCommand(uint32_t commandId, const void *packet, uint32_t size, IopGuestExecutor &executor)
+    {
+        constexpr uint32_t kMaxPacketSize = 128u;
+        const auto it = m_cmdHandlers.find(commandId);
+        if (it == m_cmdHandlers.end() || packet == nullptr || size == 0u || size > kMaxPacketSize)
+            return false;
+        if (m_cmdPacketBuffer == 0u)
+            m_cmdPacketBuffer = m_memory.allocate(kMaxPacketSize, 16u);
+        if (m_cmdPacketBuffer == 0u || !m_memory.writeRam(m_cmdPacketBuffer, packet, size))
+            return false;
+        // Handlers run in interrupt context on hardware; they usually just
+        // record the request and wake a module thread.
+        (void)executor.executeGuestFunctionWithBudget(it->second.function,
+                                                      m_cmdPacketBuffer,
+                                                      it->second.data,
+                                                      0u,
+                                                      0u,
+                                                      it->second.gp,
+                                                      100000u);
+        return true;
+    }
