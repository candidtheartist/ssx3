+// MSKPATH3 masks PATH3 only between GIF packets, so clearing it lets the GIF start the next queued packet,
+// which then runs to its end even if the mask is set again straight away. Games stream textures this way:
+// a VIF1 list unmasks and remasks PATH3 once per texture, so that exactly one upload lands between the
+// draws that use the previous texture and the draws that use the next.
+void PS2Memory::releaseMaskedPath3Packet()
+{
+    bool released = false;
+    while (!m_path3MaskedFifo.empty())
+    {
+        const auto &transfer = m_path3MaskedFifo.front();
+        bool endsPacket = false;
+        const size_t end = gifPacketEnd(transfer.data(), transfer.size(), m_path3MaskedHead, endsPacket);
+        if (end >= m_path3MaskedHead + 16u)
+        {
+            const uint8_t *packet = transfer.data() + m_path3MaskedHead;
+            const uint32_t packetSize = static_cast<uint32_t>(end - m_path3MaskedHead);
+            if (m_gifArbiter)
+                m_gifArbiter->submit(GifPathId::Path3, packet, packetSize, false);
+            else if (m_gifPacketCallback)
+                m_gifPacketCallback(packet, packetSize);
+            released = true;
+        }
+        if (end + 16u <= transfer.size())
+        {
+            m_path3MaskedHead = end;
+        }
+        else
+        {
+            m_path3MaskedFifo.erase(m_path3MaskedFifo.begin());
+            m_path3MaskedHead = 0u;
+        }
+        if (endsPacket)
+            break;
+    }
+
+    if (m_gifArbiter && released)
+        m_gifArbiter->drain();
+}
