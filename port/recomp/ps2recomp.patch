+
+PresentationFrame GSThreadedBackend::Present(const GSPresentationRequest &request)
+{
+    // The presenting thread also polls input, so it must not wait for the GS, not even
+    // for room in a full queue. A request is captured once everything submitted before
+    // it has been drawn; until then this keeps returning the last captured frame.
+    {
+        std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+        bool queued;
+        {
+            std::lock_guard<ps2_host_sync::Mutex> presentLock(m_presentMutex);
+            queued = m_presentQueued;
+            if (!queued)
+            {
+                m_presentRequest = request;
+                m_presentQueued = true;
+            }
+        }
+        if (!queued)
+        {
+            markRunAlone(beginCommand(lock, CommandKind::Present, false));
+            endCommand(lock);
+        }
+    }
+    std::lock_guard<ps2_host_sync::Mutex> lock(m_presentMutex);
+    return m_lastPresented;
+}
+
+bool GSThreadedBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    // The CPU backend clears 32-, 24- and 16-bit framebuffers and reports anything
+    // else as not handled, so the answer is known before the clear runs.
+    const uint32_t psm = context.frame.psm;
+    const bool handled = m_vram && context.frame.fbw != 0u &&
+                         (psm == GS_PSM_CT32 || psm == GS_PSM_CT24 || psm == GS_PSM_CT16 || psm == GS_PSM_CT16S);
+    if (!handled)
+        return false;
+
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::ClearFramebuffer);
+    command.batch.state.context = context;
+    command.args[0] = rgba;
+    if (m_workers.size() > 1u)
+    {
+        PageTracker::Access drawn{};
+        const uint32_t fbp = GSInternal::framePageBaseToBlock(context.frame.fbp);
+        drawn.layout = layoutKey(fbp, context.frame.fbw, psm);
+        PageTracker::AddPages(drawn.pages, fbp, context.frame.fbw, psm,
+                              context.scissor.x0, context.scissor.y0,
+                              std::max(context.scissor.x0, context.scissor.x1),
+                              std::max(context.scissor.y0, context.scissor.y1));
+        classifyDraw(command, &drawn, 1u, PageTracker::PageSet{}, false);
+    }
+    endCommand(lock);
+    return true;
+}
+
+uint32_t GSThreadedBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    waitForQueuedWork();
+    GSCpuBackend &backend = *m_workers[0].backend;
+    const uint32_t consumed = backend.ConsumeLocalToHostBytes(dst, maxBytes);
+    const GSTransferSnapshot snapshot = backend.GetTransferSnapshot();
+    std::lock_guard<ps2_host_sync::Mutex> lock(m_transferMutex);
+    m_transferSnapshot = snapshot;
+    return consumed;
+}
+
+uint32_t GSThreadedBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    waitForQueuedWork();
+    return m_workers[0].backend->ReadVram(psm, base, bw, x, y);
+}
+
+void GSThreadedBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::WriteVram);
+    command.args[0] = psm;
+    command.args[1] = base;
+    command.args[2] = bw;
+    command.args[3] = x;
+    command.args[4] = y;
+    command.args[5] = value;
+    PageTracker::PageSet pages{};
+    PageTracker::AddPages(pages, base, std::max<uint32_t>(bw, 1u), psm, static_cast<int>(x), static_cast<int>(y),
+                          static_cast<int>(x), static_cast<int>(y));
+    markDrawn(pages);
+    markRunAlone(command);
+    endCommand(lock);
+}
+
+void GSThreadedBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    waitForQueuedWork();
+    m_workers[0].backend->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSThreadedBackend::GetTransferSnapshot() const
+{
+    // GS records this with every draw for its debug history, so wait only for queued
+    // transfers, and read the worker's copy instead of locking a drawing backend.
+    {
+        std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+        waitForCompleted(lock, m_lastTransferCommand);
+    }
+    std::lock_guard<ps2_host_sync::Mutex> lock(m_transferMutex);
+    return m_transferSnapshot;
+}
