+    bool readsOnlyItsOwnPixels(const GSPrimitiveBatch &batch)
+    {
+        const GSDrawState &state = batch.state;
+        const GSContext &ctx = state.context;
+        if (state.prim.type != GS_PRIM_SPRITE || !state.prim.tme || !state.prim.fst || state.linearFilter)
+            return false;
+
+        // The 32-bit colour formats and the 8- and 4-bit formats kept in their top bits
+        // all lay pixels out the same way.
+        const auto ct32Layout = [](uint32_t psm)
+        {
+            return psm == GS_PSM_CT32 || psm == GS_PSM_CT24 || psm == GS_PSM_T8H ||
+                   psm == GS_PSM_T4HL || psm == GS_PSM_T4HH;
+        };
+        if ((ctx.frame.psm != GS_PSM_CT32 && ctx.frame.psm != GS_PSM_CT24) || !ct32Layout(ctx.tex0.psm) ||
+            ctx.tex0.tbp0 != GSInternal::framePageBaseToBlock(ctx.frame.fbp) ||
+            ctx.tex0.tbw != std::max<uint32_t>(ctx.frame.fbw, 1u))
+            return false;
+
+        // REPEAT and CLAMP leave texels inside the texture where they are.
+        const uint64_t clamp = ctx.clamp;
+        if ((clamp & 3u) > 1u || ((clamp >> 2) & 3u) > 1u)
+            return false;
+
+        // The same pixel to texel mapping as GSCpuBackend::DrawSprite: the texel a pixel
+        // samples is its offset into the sprite plus the first vertex's UV.
+        const GSVertex &v0 = batch.vertices[0];
+        const GSVertex &v1 = batch.vertices[1];
+        const int ofx = static_cast<int>(ctx.xyoffset.ofx >> 4);
+        const int ofy = static_cast<int>(ctx.xyoffset.ofy >> 4);
+        const int x0 = static_cast<int>(v0.x) - ofx;
+        const int y0 = static_cast<int>(v0.y) - ofy;
+        const int x1 = static_cast<int>(v1.x) - ofx;
+        const int y1 = static_cast<int>(v1.y) - ofy;
+        const int u0 = v0.u >> 4;
+        const int t0 = v0.v >> 4;
+        return x1 > x0 && y1 > y0 && x0 >= 0 && y0 >= 0 &&
+               u0 == x0 && t0 == y0 && (v1.u >> 4) - u0 == x1 - x0 && (v1.v >> 4) - t0 == y1 - y0 &&
+               x1 <= static_cast<int>(state.textureWidth) && y1 <= static_cast<int>(state.textureHeight);
+    }
+
+    // The texel columns (or rows) that coordinates in [lo, hi] reach after wrapping.
+    void wrapTexelRange(float lo, float hi, bool bounded, int size, uint32_t mode, int regionMin, int regionMax,
+                        int &first, int &last)
+    {
+        first = 0;
+        last = size - 1;
+        if (mode == 3u)
+        {
+            // REGION_REPEAT
+            last = std::max(last, regionMin | regionMax);
+            return;
+        }
+        if (!bounded)
+        {
+            if (mode == 2u)
+                last = std::max(last, std::max(regionMin, regionMax));
+            return;
+        }
+
+        const int lowest = static_cast<int>(std::floor(lo));
+        const int highest = static_cast<int>(std::ceil(hi));
+        switch (mode)
+        {
+        case 0u: // REPEAT
+            if (lowest >= 0 && highest < size)
+            {
+                first = lowest;
+                last = highest;
+            }
+            break;
+        case 1u: // CLAMP
+            first = std::clamp(lowest, 0, size - 1);
+            last = std::clamp(highest, 0, size - 1);
+            break;
+        default: // REGION_CLAMP
+            first = std::min(std::max(lowest, regionMin), regionMax);
+            last = std::min(std::max(highest, regionMin), regionMax);
+            break;
+        }
+    }
