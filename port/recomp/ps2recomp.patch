diff --git a/ps2xTest/src/vu1_test_blocks.cpp b/ps2xTest/src/vu1_test_blocks.cpp
new file mode 100644
index 0000000..cd13a05
--- /dev/null
+++ b/ps2xTest/src/vu1_test_blocks.cpp
@@ -0,0 +1,77 @@
+// Generates block code for the first VU1 fuzz programs (vu1_fuzzer.h), for
+// ps2x_tests to link, so the VU1 tests run those programs through generated
+// blocks the way the game runs its own.
+//
+// usage: ps2x_vu1_test_blocks OUT_PREFIX SHARDS
+
+#include "vu1_fuzzer.h"
+#if defined(__SSE4_1__)
+#include "vu/ps2_vu1_compiled.h"
+#endif
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+int main(int argc, char **argv)
+{
+    if (argc < 3)
+    {
+        std::fprintf(stderr, "usage: %s OUT_PREFIX SHARDS\n", argv[0]);
+        return 2;
+    }
+    const std::string prefix = argv[1];
+    const int shardCount = std::atoi(argv[2]);
+    if (shardCount < 1)
+        return 2;
+    std::vector<std::FILE *> shards;
+    for (int i = 0; i < shardCount; ++i)
+    {
+        shards.push_back(std::fopen((prefix + std::to_string(i) + ".cpp").c_str(), "w"));
+        if (!shards.back())
+            return 1;
+    }
+#if defined(__SSE4_1__)
+    // Record the blocks the programs compile, as a game run would.
+    const std::string listPath = prefix + "list.txt";
+    std::remove(listPath.c_str());
+#if defined(_WIN32)
+    _putenv_s("PS2X_VU1_BLOCK_LIST", listPath.c_str());
+#else
+    setenv("PS2X_VU1_BLOCK_LIST", listPath.c_str(), 1);
+#endif
+    PS2Memory mem;
+    if (!mem.initialize())
+        return 1;
+    GS gs;
+    gs.init(mem.getGSVRAM(), static_cast<uint32_t>(PS2_GS_VRAM_SIZE), &mem.gs());
+    uint8_t *code = mem.getVU1Code();
+    uint8_t *data = mem.getVU1Data();
+    VU1Interpreter vu;
+    vu.setCompiledEnabled(true);
+    std::vector<std::vector<uint8_t>> images;
+    for (uint32_t program = 0; program < vu1fuzz::kGeneratedPrograms; ++program)
+    {
+        vu1fuzz::runProgram(vu, mem, gs, code, data, program);
+        images.emplace_back(code, code + PS2_VU1_CODE_SIZE);
+    }
+    std::FILE *list = std::fopen(listPath.c_str(), "r");
+    if (!list)
+        return 1;
+    size_t listed = 0;
+    const size_t written = VU1CompiledAccess::generate(images, list, shards, listed);
+    std::fclose(list);
+    std::printf("VU1 test blocks: %zu of %zu generated\n", written, listed);
+    for (std::FILE *shard : shards)
+        std::fclose(shard);
+    return written == listed ? 0 : 1;
+#else
+    for (std::FILE *shard : shards)
+    {
+        std::fprintf(shard, "// Generated VU1 blocks need SSE4.1.\n");
+        std::fclose(shard);
+    }
+    return 0;
+#endif
+}
