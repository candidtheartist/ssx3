+        // A UV triangle converts its interpolated coordinate to 16 bits, so one that
+        // dips below zero wraps to the far edge.
+        const bool triangle = state.prim.type != GS_PRIM_SPRITE;
+        if (state.prim.fst && triangle && (minU < 0.0f || minV < 0.0f))
+            return false;
+        return minU >= -65536.0f && maxU <= 65536.0f && minV >= -65536.0f && maxV <= 65536.0f;
+    }
+
+    // Whether a sprite copies its own target onto itself, each pixel reading the texel at
+    // its own address: an unfiltered, unflipped 1:1 UV sprite whose texture has the
+    // frame's base, width and pixel layout. Each pixel then reads only what its own
