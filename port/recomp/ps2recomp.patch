+// never touches; SetupHeap and EndOfHeap then report the game's own range.
+struct Ps2xGuestScratchRegion
+{
+    uint32_t base = 0u;
+    uint32_t limit = 0u;
+    [[nodiscard]] bool active() const { return limit > base; }
+};
+
+extern Ps2xGuestScratchRegion g_ps2xGuestScratch;
+// The range the game asked for through SetupHeap while a scratch region is active.
+extern uint32_t g_ps2xGameHeapBase;
+extern uint32_t g_ps2xGameHeapLimit;
