diff --git a/ps2xRuntime/include/runtime/ps2_host_fpu.h b/ps2xRuntime/include/runtime/ps2_host_fpu.h
new file mode 100644
index 0000000..f7c76fc
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host_fpu.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <cfenv>
+
+#if (defined(__i386__) || defined(__x86_64__)) && (defined(__GNUC__) || defined(__clang__))
+#include <xmmintrin.h>
+#define PS2X_HOST_FPU_X86 1
+#endif
+
+// The host rounding mode, changed without the C library on x86. MinGW's 32-bit
+// fesetround, fegetenv and fesetenv check for SSE with CPUID on every call, and CPUID
+// traps into the hypervisor when Windows runs under one. The VU1 thread changes the
+// mode around every VU1 program it runs, so those calls added up.
+namespace ps2_host_fpu
+{
+#if defined(PS2X_HOST_FPU_X86)
+    // The FE_* values differ between C libraries (glibc and older MinGW use the x87
+    // control word's bits, newer MinGW-w64 uses _controlfp's _RC_* values), so they are
+    // mapped to the x87 rounding bits here. The MXCSR has the same two bits three places
+    // higher.
+    inline unsigned x87Bits(int mode)
+    {
+        switch (mode)
+        {
+        case FE_TONEAREST:
+            return 0x000u;
+        case FE_DOWNWARD:
+            return 0x400u;
+        case FE_UPWARD:
+            return 0x800u;
+        case FE_TOWARDZERO:
+            return 0xC00u;
+        default:
+            return ~0u;
+        }
+    }
+#endif
+
+    inline int getRounding()
+    {
+#if defined(PS2X_HOST_FPU_X86)
+        unsigned short cw;
+        __asm__ volatile("fnstcw %0" : "=m"(cw));
+        switch (cw & 0x0C00u)
+        {
+        case 0x400u:
+            return FE_DOWNWARD;
+        case 0x800u:
+            return FE_UPWARD;
+        case 0xC00u:
+            return FE_TOWARDZERO;
+        default:
+            return FE_TONEAREST;
+        }
+#else
+        return std::fegetround();
+#endif
+    }
+
+    // Returns true once the mode is set, like fesetround returning 0.
+    inline bool setRounding(int mode)
+    {
+#if defined(PS2X_HOST_FPU_X86)
+        const unsigned bits = x87Bits(mode);
+        if (bits == ~0u)
+            return false;
+        unsigned short cw;
+        __asm__ volatile("fnstcw %0" : "=m"(cw));
+        const unsigned short newCw = static_cast<unsigned short>((cw & ~0x0C00u) | bits);
+        if (newCw != cw)
+            __asm__ volatile("fldcw %0" : : "m"(newCw) : "memory");
+        const unsigned int csr = _mm_getcsr();
+        const unsigned int newCsr = (csr & ~0x6000u) | (bits << 3);
+        if (newCsr != csr)
+            _mm_setcsr(newCsr);
+        return true;
+#else
+        return std::fesetround(mode) == 0;
+#endif
+    }
+}
diff --git a/ps2xRuntime/include/runtime/ps2_host_sync.h b/ps2xRuntime/include/runtime/ps2_host_sync.h
new file mode 100644
index 0000000..bf12500
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host_sync.h
@@ -0,0 +1,142 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <utility>
+
+// The mutex and condition variable of the threads that hand each other work many times
+// a frame: the EE scheduler, the VU1 thread and the GS workers. MinGW's std::mutex and
+// std::condition_variable are winpthreads', whose condition variable sleeps on a
+// semaphore through WaitForMultipleObjects and wakes through ReleaseSemaphore, both
+// system calls every time; on a Windows PC the GS workers spent about a fifth of a core
+// each in them. Windows' own slim reader/writer lock and condition variable stay in user
+// mode unless a thread really has to sleep. Elsewhere these are the standard types.
+namespace ps2_host_sync
+{
+#if defined(_WIN32)
+    class Mutex
+    {
+    public:
+        Mutex() = default;
+        Mutex(const Mutex &) = delete;
+        Mutex &operator=(const Mutex &) = delete;
+
+        void lock();
+        bool try_lock();
+        void unlock();
+
+    private:
+        friend class CondVar;
+        void *m_lock = nullptr; // an SRWLOCK
+    };
+
+    class CondVar
+    {
+    public:
+        CondVar() = default;
+        CondVar(const CondVar &) = delete;
+        CondVar &operator=(const CondVar &) = delete;
+
+        void notify_one() noexcept;
+        void notify_all() noexcept;
+        void wait(std::unique_lock<Mutex> &lock);
+        template <class Predicate>
+        void wait(std::unique_lock<Mutex> &lock, Predicate pred)
+        {
+            while (!pred())
+                wait(lock);
+        }
+
+        // Like std::condition_variable::wait_until: false if the deadline passed with
+        // pred still false. Windows sleeps in whole milliseconds, so the last part of a
+        // millisecond is waited out by yielding, which keeps the EE's vblank pacing exact.
+        template <class Clock, class Duration, class Predicate>
+        bool wait_until(std::unique_lock<Mutex> &lock,
+                        const std::chrono::time_point<Clock, Duration> &deadline, Predicate pred)
+        {
+            while (!pred())
+            {
+                const auto now = Clock::now();
+                if (now >= deadline)
+                    return pred();
+                const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count();
+                waitMs(lock, left > static_cast<long long>(kMaxWaitMs) ? kMaxWaitMs
+                                                                        : static_cast<unsigned long>(left));
+            }
+            return true;
+        }
+
+    private:
+        static constexpr unsigned long kMaxWaitMs = 0x7FFFFFFFul;
+        // Sleeps at most ms milliseconds, or only yields when ms is 0.
+        void waitMs(std::unique_lock<Mutex> &lock, unsigned long ms);
+
+        void *m_cv = nullptr; // a CONDITION_VARIABLE
+    };
+#else
+    using Mutex = std::mutex;
+    using CondVar = std::condition_variable;
+#endif
+
+    // How many times a GS worker that ran out of work, or waits at a Barrier, checks
+    // again with a pause before it sleeps. PS2X_GS_SPIN overrides it.
+    unsigned spinCount();
+    void spinPause();
+
+    // A barrier for a fixed number of threads, like std::barrier (whose waits also go
+    // through winpthreads with MinGW): the last thread to arrive runs the completion
+    // while the others wait, then releases them. A waiting thread checks for a while
+    // before it sleeps, since the others are often close behind.
+    template <class Completion>
+    class Barrier
+    {
+    public:
+        Barrier(std::ptrdiff_t count, Completion completion)
+            : m_count(count), m_left(count), m_completion(std::move(completion)), m_spins(spinCount())
+        {
+        }
+
+        void arrive_and_wait()
+        {
+            std::unique_lock<Mutex> lock(m_mutex);
+            const uint64_t phase = m_phase.load(std::memory_order_relaxed);
+            if (--m_left == 0)
+            {
+                m_completion();
+                m_left = m_count;
+                m_phase.store(phase + 1u, std::memory_order_release);
+                const bool sleepers = m_sleepers != 0u;
+                lock.unlock();
+                if (sleepers)
+                    m_released.notify_all();
+                return;
+            }
+            lock.unlock();
+            for (unsigned spin = 0; spin < m_spins; ++spin)
+            {
+                if (m_phase.load(std::memory_order_acquire) != phase)
+                    return;
+                spinPause();
+            }
+            lock.lock();
+            ++m_sleepers;
+            m_released.wait(lock, [&]
+                            { return m_phase.load(std::memory_order_relaxed) != phase; });
+            --m_sleepers;
+        }
+
+    private:
+        Mutex m_mutex;
+        CondVar m_released;
+        const std::ptrdiff_t m_count;
+        std::ptrdiff_t m_left;           // with m_mutex held
+        uint32_t m_sleepers = 0;         // with m_mutex held
+        std::atomic<uint64_t> m_phase{0}; // changed with m_mutex held
+        Completion m_completion;
+        const unsigned m_spins;
+    };
+}
