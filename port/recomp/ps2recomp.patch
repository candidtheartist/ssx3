+
+void PS2AudioBackend::queueSpuOutput(uint32_t core, const int16_t *frames, size_t frameCount)
+{
+    if (core >= m_impl->spuQueues.size() || !frames || frameCount == 0u)
+        return;
+    Impl::SpuQueue &queue = m_impl->spuQueues[core];
+    const size_t written = queue.written.load(std::memory_order_relaxed);
+    const size_t read = queue.read.load(std::memory_order_acquire);
+    if (frameCount > kSpuQueueFrames - (written - read))
+        return;
+
+    const size_t start = written % kSpuQueueFrames;
+    const size_t first = std::min(frameCount, kSpuQueueFrames - start);
+    std::memcpy(queue.samples.data() + start * 2u, frames, first * 2u * sizeof(int16_t));
+    std::memcpy(queue.samples.data(), frames + first * 2u, (frameCount - first) * 2u * sizeof(int16_t));
+    queue.written.store(written + frameCount, std::memory_order_release);
+}
+
+size_t PS2AudioBackend::readSpuOutput(int16_t *frames, size_t frameCount)
+{
+    std::memset(frames, 0, frameCount * 2u * sizeof(int16_t));
+    size_t played = 0u;
+    for (Impl::SpuQueue &queue : m_impl->spuQueues)
+    {
+        const size_t read = queue.read.load(std::memory_order_relaxed);
+        const size_t available = queue.written.load(std::memory_order_acquire) - read;
+        if (queue.refilling && available < kSpuRefillFrames)
+            continue;
+        queue.refilling = false;
+
+        const size_t count = std::min(available, frameCount);
+        for (size_t i = 0; i < count * 2u; ++i)
+        {
+            const int32_t sample = frames[i] + queue.samples[(read * 2u + i) % (kSpuQueueFrames * 2u)];
+            frames[i] = static_cast<int16_t>(std::clamp<int32_t>(sample, std::numeric_limits<int16_t>::min(),
+                                                                  std::numeric_limits<int16_t>::max()));
+        }
+        queue.read.store(read + count, std::memory_order_release);
+        queue.refilling = count < frameCount;
+        played = std::max(played, count);
+    }
+    return played;
+}
