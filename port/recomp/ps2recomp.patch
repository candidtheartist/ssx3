+void PS2AudioBackend::setAudioReady(bool ready)
+{
+    m_audioReady = ready;
+    if (ready && !m_impl->spuStream.buffer)
+    {
+        m_impl->spuStream = LoadAudioStream(kSpuSampleRate, 16, 2);
+        if (!IsAudioStreamValid(m_impl->spuStream))
+        {
+            m_impl->spuStream = AudioStream{};
+            return;
+        }
+        g_spuOutputBackend.store(this, std::memory_order_release);
+        SetAudioStreamCallback(m_impl->spuStream, fillSpuStream);
+        PlayAudioStream(m_impl->spuStream);
+    }
+    else if (!ready && m_impl->spuStream.buffer)
+    {
+        StopAudioStream(m_impl->spuStream);
+        UnloadAudioStream(m_impl->spuStream);
+        m_impl->spuStream = AudioStream{};
+        PS2AudioBackend *self = this;
+        g_spuOutputBackend.compare_exchange_strong(self, nullptr, std::memory_order_acq_rel);
+    }
