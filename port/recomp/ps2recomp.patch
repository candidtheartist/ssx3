+bool VU1Interpreter::execUpperVector(uint32_t instr)
+{
+#if PS2X_VU_VECTOR_FMAC
+    const uint8_t op = static_cast<uint8_t>(instr & 0x3Fu);
+    const uint32_t components = kReverseLanes[DEST(instr)];
+    if (op < 0x3Cu)
+    {
+        // MAX and MINI. maxps and minps return their second operand unless the
+        // first is greater (or less), as the comparisons here do; normalized
+        // operands are never NaN.
+        __m128 rhs;
+        if (op >= 0x10u && op <= 0x17u)
+        {
+            const __m128 vt = normalizeOperands(_mm_loadu_ps(m_state.vf[FT(instr)]));
+            switch (op & 3u)
+            {
+            case 0u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(0, 0, 0, 0)); break;
+            case 1u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(1, 1, 1, 1)); break;
+            case 2u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(2, 2, 2, 2)); break;
+            default: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(3, 3, 3, 3)); break;
+            }
+        }
+        else if (op == 0x1Du || op == 0x1Fu)
+            rhs = _mm_set1_ps(vuNormalizeOperand(m_state.i));
+        else if (op == 0x2Bu || op == 0x2Fu)
+            rhs = normalizeOperands(_mm_loadu_ps(m_state.vf[FT(instr)]));
+        else
+            return false;
+        const __m128 vs = normalizeOperands(_mm_loadu_ps(m_state.vf[FS(instr)]));
+        const bool max = op <= 0x13u || op == 0x1Du || op == 0x2Bu;
+        writeLanes(m_state.vf[FD(instr)], max ? _mm_max_ps(vs, rhs) : _mm_min_ps(vs, rhs), components);
+        return true;
+    }
+
+    const uint8_t special = static_cast<uint8_t>((instr & 0x3u) | ((instr >> 4) & 0x7Cu));
+    float *vtDest = m_state.vf[FT(instr)];
+    // The fixed-point scales of ITOF and FTOI are powers of two, so a float
+    // product by one (or its reciprocal) is exact unless it overflows.
+    static constexpr float kScales[4] = {1.0f, 16.0f, 4096.0f, 32768.0f};
+    static constexpr float kInverseScales[4] = {1.0f, 1.0f / 16.0f, 1.0f / 4096.0f, 1.0f / 32768.0f};
+    if (special >= 0x10u && special <= 0x13u) // ITOF
+    {
+        const __m128i bits = _mm_castps_si128(_mm_loadu_ps(m_state.vf[FS(instr)]));
+        writeLanes(vtDest, _mm_mul_ps(_mm_cvtepi32_ps(bits), _mm_set1_ps(kInverseScales[special & 3u])), components);
+        return true;
+    }
+    if (special >= 0x14u && special <= 0x17u) // FTOI
+    {
+        // An overflowing product rounds toward zero to FLT_MAX, which clamps
+        // like any value of at least 2^31; cvttps2dq gives INT32_MIN for the
+        // negative ones itself.
+        const __m128 scaled = _mm_mul_ps(normalizeOperands(_mm_loadu_ps(m_state.vf[FS(instr)])),
+                                         _mm_set1_ps(kScales[special & 3u]));
+        const __m128i truncated = _mm_cvttps_epi32(scaled);
+        const __m128 positiveOverflow = _mm_cmpge_ps(scaled, _mm_set1_ps(2147483648.0f));
+        const __m128 result = _mm_blendv_ps(_mm_castsi128_ps(truncated),
+                                            _mm_castsi128_ps(_mm_set1_epi32(std::numeric_limits<int32_t>::max())),
+                                            positiveOverflow);
+        writeLanes(vtDest, result, components);
+        return true;
+    }
+    if (special == 0x1Du) // ABS
+    {
+        const __m128 vs = normalizeOperands(_mm_loadu_ps(m_state.vf[FS(instr)]));
+        writeLanes(vtDest, _mm_and_ps(vs, _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF))), components);
+        return true;
+    }
+    return false;
+#else
+    (void)instr;
+    return false;
+#endif
+}
+
+void VU1Interpreter::execClip(uint32_t instr)
+{
+    const uint8_t fs = FS(instr);
+    uint32_t wBits = 0u;
+    std::memcpy(&wBits, &m_state.vf[FT(instr)][3], sizeof(wBits));
+    const int32_t limit = (wBits & 0x7F800000u) != 0u ? static_cast<int32_t>(wBits & 0x7FFFFFFFu) : 0x007FFFFF;
+
+    const auto exceedsClipPlane = [limit](float value, uint32_t signMask)
+    {
+        uint32_t bits = 0u;
+        std::memcpy(&bits, &value, sizeof(bits));
+        bits ^= signMask;
+        int32_t orderedBits = 0;
+        std::memcpy(&orderedBits, &bits, sizeof(orderedBits));
+        return orderedBits > limit;
+    };
+
+    uint32_t flags = 0u;
+    if (exceedsClipPlane(m_state.vf[fs][0], 0x00000000u))
+        flags |= 0x01u;
+    if (exceedsClipPlane(m_state.vf[fs][0], 0x80000000u))
+        flags |= 0x02u;
+    if (exceedsClipPlane(m_state.vf[fs][1], 0x00000000u))
+        flags |= 0x04u;
+    if (exceedsClipPlane(m_state.vf[fs][1], 0x80000000u))
+        flags |= 0x08u;
+    if (exceedsClipPlane(m_state.vf[fs][2], 0x00000000u))
+        flags |= 0x10u;
+    if (exceedsClipPlane(m_state.vf[fs][2], 0x80000000u))
+        flags |= 0x20u;
+    queueClip(flags);
+}
