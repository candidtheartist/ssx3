+namespace ps2vu1c
+{
+    // Pipeline timing at the start of a pair: cycles until each queued result is
+    // due, after that cycle's commits. Stalls depend on nothing else, so a block
+    // started in a known timing state has fixed stalls.
+    struct VuTiming
+    {
+        std::array<uint8_t, 128> vf{}; // register * 4 + component
+        std::array<uint8_t, 16> vi{};
+        uint8_t fdiv = 0;
+        uint8_t efuResource = 0;
+        std::array<uint8_t, 2> efu{};
+
+        bool operator==(const VuTiming &other) const { return std::memcmp(this, &other, sizeof(VuTiming)) == 0; }
+    };
+    static_assert(sizeof(VuTiming) == 148);
+
+    struct VuTimingHash
+    {
+        size_t operator()(const VuTiming &timing) const
+        {
+            const auto *bytes = reinterpret_cast<const uint8_t *>(&timing);
+            uint64_t hash = 0xCBF29CE484222325ull;
+            for (size_t i = 0; i < sizeof(VuTiming); i += 4)
+            {
+                uint32_t word = 0;
+                std::memcpy(&word, bytes + i, 4);
+                hash = (hash ^ word) * 0x100000001B3ull;
+            }
+            return static_cast<size_t>(hash ^ (hash >> 32));
+        }
+    };
+
+    inline bool isLowerNop(uint32_t instr)
+    {
+        return instr == 0x00000000u || instr == 0x8000033Cu;
+    }
+
+    inline uint8_t countDown(uint8_t value, uint32_t cycles)
+    {
+        return value > cycles ? static_cast<uint8_t>(value - cycles) : 0u;
+    }
+
+    inline void advanceTiming(VuTiming &timing, uint32_t cycles)
+    {
+        if (cycles == 0u)
+            return;
+        for (uint8_t &value : timing.vf)
+            value = countDown(value, cycles);
+        for (uint8_t &value : timing.vi)
+            value = countDown(value, cycles);
+        timing.fdiv = countDown(timing.fdiv, cycles);
+        timing.efuResource = countDown(timing.efuResource, cycles);
+        for (uint8_t &value : timing.efu)
+            value = countDown(value, cycles);
+    }
+
+    // Lanes in VU order (x is bit 3), as dest fields have them.
+    inline __m128 laneMask(uint8_t lanes)
+    {
+        const __m128i laneBits = _mm_set_epi32(1, 2, 4, 8);
+        return _mm_castsi128_ps(_mm_cmpeq_epi32(_mm_and_si128(_mm_set1_epi32(lanes), laneBits), laneBits));
+    }
+
+    inline void blendLanes(float *dst, const float *src, uint8_t dest)
+    {
+        _mm_storeu_ps(dst, _mm_blendv_ps(_mm_loadu_ps(dst), _mm_loadu_ps(src), laneMask(dest)));
+    }
+
+    // What issueVfWrite does to the lanes an op wrote outside its declared ones.
+    inline void keepDeclaredLanes(float *reg, const float *previous, uint8_t lanes)
+    {
+        _mm_storeu_ps(reg, _mm_blendv_ps(_mm_loadu_ps(previous), _mm_loadu_ps(reg), laneMask(lanes)));
+    }
+
+    // VU1 code memory is 16 KiB.
+    inline constexpr uint32_t kVu1PcMask = 0x3FFFu;
+
+    // vuNormalizeOperand on four lanes.
+    __attribute__((always_inline)) inline __m128 normalizeOperands(__m128 value)
+    {
+        const __m128i bits = _mm_castps_si128(value);
+        const __m128i exponent = _mm_and_si128(bits, _mm_set1_epi32(0x7F800000));
+        const __m128i sign = _mm_and_si128(bits, _mm_set1_epi32(static_cast<int32_t>(0x80000000u)));
+        __m128i normalized = _mm_blendv_epi8(bits, sign, _mm_cmpeq_epi32(exponent, _mm_setzero_si128()));
+        normalized = _mm_blendv_epi8(normalized, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF)),
+                                     _mm_cmpeq_epi32(exponent, _mm_set1_epi32(0x7F800000)));
+        return _mm_castsi128_ps(normalized);
+    }
+
+    // Swaps a 4-bit mask between component order (x in bit 0, as movemask
+    // gives it) and VU lane order (x in bit 3).
+    inline constexpr uint8_t kReverseLanes[16] = {0x0u, 0x8u, 0x4u, 0xCu, 0x2u, 0xAu, 0x6u, 0xEu,
+                                           0x1u, 0x9u, 0x5u, 0xDu, 0x3u, 0xBu, 0x7u, 0xFu};
+
+    // Stores the components in mask (x in bit 0).
+    inline void writeLanes(float *dst, __m128 value, uint32_t mask)
+    {
+        const __m128i laneBits = _mm_set_epi32(8, 4, 2, 1);
+        const __m128 written = _mm_castsi128_ps(
+            _mm_cmpeq_epi32(_mm_and_si128(_mm_set1_epi32(static_cast<int32_t>(mask)), laneBits), laneBits));
+        _mm_storeu_ps(dst, _mm_blendv_ps(_mm_loadu_ps(dst), value, written));
+    }
+
+    inline constexpr uint64_t kFnv1aSeed = 0xCBF29CE484222325ull;
+    inline uint64_t fnv1a64(const void *data, size_t size, uint64_t hash = kFnv1aSeed)
+    {
+        const auto *bytes = static_cast<const uint8_t *>(data);
+        for (size_t i = 0; i < size; ++i)
+            hash = (hash ^ bytes[i]) * 0x100000001B3ull;
+        return hash;
+    }
+
+    inline uint64_t timingKey(const VuTiming &timing) { return fnv1a64(&timing, sizeof(timing)); }
+}
+using namespace ps2vu1c;
+
+// A block's pairs as straight-line code, generated at build time from its
+// compiled form (VU1CompiledAccess::generate). Runs the block as
+// runCompiled's loop would; returns how many pairs ran, with kGeneratedCut set
+// when the interpreter must take over before the next one.
+using GeneratedBlockFn = uint32_t (*)(VU1Interpreter &vu, const void *pairs, uint8_t *vuData, uint32_t dataSize,
+                                      GS &gs, PS2Memory *memory, bool &programEnded);
+inline constexpr uint32_t kGeneratedCut = 0x80000000u;
+struct VU1GeneratedBlock
+{
+    uint64_t code;   // CompiledCode::codeHash of the block
+    uint32_t pc;     // with bit 16 for a delay slot
+    uint64_t timing; // timingKey of the entry timing
+    GeneratedBlockFn run;
+};
+// The generated code registers its blocks here, before main.
+void registerGeneratedBlocks(const VU1GeneratedBlock *blocks, size_t count);
+size_t generatedBlockCount();
+GeneratedBlockFn findGeneratedBlock(uint64_t code, uint32_t pc, uint64_t timing);
+// With PS2X_VU1_BLOCK_LIST set to a file, appends each block compiled to it
+// as a block list line (see VU1CompiledAccess::generate). Lines hold only
+// numbers: the start pc, the code hash and the entry timing.
+void recordCompiledBlock(uint32_t pc, uint64_t code, const VuTiming &timing);
+
+__attribute__((always_inline)) inline void VU1Interpreter::pushCompiledFmacFlags(uint32_t mac, uint32_t statusSet)
+{
+    if (m_flagCount == kMaxFlagEntries) [[unlikely]]
+    {
+        commitFlagsUpTo(m_cycle);
+        if (m_flagCount == kMaxFlagEntries)
+        {
+            reportReservedInstruction(true, 0xFFFFFFFFu);
+            return;
+        }
+    }
+    FlagPipelineEntry &entry = m_flagPipeline[(m_flagHead + m_flagCount++) % kMaxFlagEntries];
+    entry.issueCycle = m_cycle;
+    entry.readyCycle = m_cycle + kFmacLatency;
+    entry.macKeep = 0u;
+    entry.macSet = mac;
+    entry.statusKeep = 0xFF0u;
+    entry.statusSet = statusSet;
+    entry.clipKeep = ~0u;
+    entry.clipSet = 0u;
+}
+
+__attribute__((always_inline)) inline bool VU1Interpreter::execFmacCompiled(const CompiledFmac &op)
+{
+    const __m128 vt = normalizeOperands(_mm_loadu_ps(m_state.vf[op.ft]));
+    __m128 rhs;
+    switch (op.rhs)
+    {
+    case 0u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(0, 0, 0, 0)); break;
+    case 1u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(1, 1, 1, 1)); break;
+    case 2u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(2, 2, 2, 2)); break;
+    case 3u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(3, 3, 3, 3)); break;
+    case 4u: rhs = _mm_set1_ps(vuNormalizeOperand(m_state.i)); break;
+    case 5u: rhs = _mm_set1_ps(vuNormalizeOperand(m_state.q)); break;
+    case 6u: rhs = vt; break;
+    default: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(3, 1, 0, 2)); break;
+    }
+    __m128 vs = normalizeOperands(_mm_loadu_ps(m_state.vf[op.fs]));
+    if (op.rhs == 7u)
+        vs = _mm_shuffle_ps(vs, vs, _MM_SHUFFLE(3, 0, 2, 1));
+
+    // A float result strictly between FLT_MIN and FLT_MAX means, in any
+    // rounding mode, that the exact value is too: only the sign flag can be
+    // set, and the float result stands. So does an exact zero, which every
+    // rounding gives the same sign in floats and doubles.
+    const __m128 magnitude = _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF));
+    const __m128 zeroValue = _mm_setzero_ps();
+    const auto strictlyNormal = [](__m128 absolute)
+    {
+        return _mm_and_ps(_mm_cmpgt_ps(absolute, _mm_set1_ps(std::numeric_limits<float>::min())),
+                          _mm_cmplt_ps(absolute, _mm_set1_ps(std::numeric_limits<float>::max())));
+    };
+    __m128 result;
+    __m128 sure;
+    __m128 zero;
+    uint32_t productSticky = 0u;
+    if (op.form <= 2u)
+    {
+        if (op.form == 0u)
+        {
+            result = _mm_add_ps(vs, rhs);
+            zero = _mm_cmpeq_ps(vs, _mm_xor_ps(rhs, _mm_set1_ps(-0.0f)));
+        }
+        else if (op.form == 1u)
+        {
+            result = _mm_sub_ps(vs, rhs);
+            zero = _mm_cmpeq_ps(vs, rhs);
+        }
+        else
+        {
+            result = _mm_mul_ps(vs, rhs);
+            zero = _mm_or_ps(_mm_cmpeq_ps(vs, zeroValue), _mm_cmpeq_ps(rhs, zeroValue));
+        }
+        sure = _mm_or_ps(zero, strictlyNormal(_mm_and_ps(result, magnitude)));
+    }
+    else
+    {
+        const __m128 acc = normalizeOperands(_mm_loadu_ps(m_state.acc));
+        const __m128 product = _mm_mul_ps(vs, rhs);
+        result = op.form == 3u ? _mm_add_ps(acc, product) : _mm_sub_ps(acc, product);
+        // The result rounds acc plus the rounded product, the exact value adds
+        // the exact product, so they differ by under 2^-23 of (product +
+        // result). With the product normal and at most 2^22 times the result,
+        // the exact value is within (1/2 + 2^-23) of the result of it: the
+        // same sign, and normal while the result is within [2^-124, 2^126].
+        const __m128 absoluteProduct = _mm_and_ps(product, magnitude);
+        const __m128 absoluteResult = _mm_and_ps(result, magnitude);
+        sure = _mm_and_ps(strictlyNormal(absoluteProduct),
+                          _mm_and_ps(_mm_cmpge_ps(absoluteResult, _mm_set1_ps(0x1p-124f)),
+                                     _mm_cmple_ps(absoluteResult, _mm_set1_ps(0x1p126f))));
+        sure = _mm_and_ps(sure, _mm_cmple_ps(absoluteProduct, _mm_mul_ps(absoluteResult, _mm_set1_ps(0x1p22f))));
+        // A zero product leaves acc exactly: an ordinary float below FLT_MAX,
+        // or a zero.
+        const __m128 zeroProduct = _mm_or_ps(_mm_cmpeq_ps(vs, zeroValue), _mm_cmpeq_ps(rhs, zeroValue));
+        const __m128 absoluteAcc = _mm_and_ps(acc, magnitude);
+        zero = _mm_and_ps(zeroProduct, _mm_cmpeq_ps(acc, zeroValue));
+        sure = _mm_or_ps(sure, _mm_and_ps(zeroProduct, _mm_cmplt_ps(absoluteAcc, _mm_set1_ps(std::numeric_limits<float>::max()))));
+        const uint32_t zeroProducts = static_cast<uint32_t>(_mm_movemask_ps(zeroProduct)) & op.components;
+        productSticky = (zeroProducts != 0u ? 0x1u : 0u) |
+                        ((static_cast<uint32_t>(_mm_movemask_ps(product)) & op.components) != 0u ? 0x2u : 0u);
+    }
+    if ((static_cast<uint32_t>(_mm_movemask_ps(sure)) & op.components) != op.components)
+        return false;
+    const uint32_t zeros = static_cast<uint32_t>(_mm_movemask_ps(zero)) & op.components;
+    const uint32_t negative = static_cast<uint32_t>(_mm_movemask_ps(result)) & op.components;
+    const uint32_t current = (zeros != 0u ? 0x1u : 0u) | (negative != 0u ? 0x2u : 0u);
+    pushCompiledFmacFlags(kReverseLanes[zeros] | (static_cast<uint32_t>(kReverseLanes[negative]) << 4),
+                          current | ((current | productSticky) << 6));
+    writeLanes(op.toAcc ? m_state.acc : m_state.vf[op.fd], result, op.components);
+    return true;
+}
+
+struct VU1Interpreter::CompiledCode
+{
+    enum UpperOp : uint8_t
+    {
+        UpperNop,
+        UpperFmac,   // CompiledFmac, falling back to execUpper
+        UpperVector, // execUpperVector
+        UpperClip,
+        UpperCall,   // execUpper
+    };
+    enum LowerOp : uint8_t
+    {
+        LowerNop,
+        LowerCall, // execLower
+        LowerLq,
+        LowerSq,
+        LowerIlw,
+        LowerIaddiu,
+        LowerIsubiu,
+        LowerFcand,
+        LowerFcor,
+        LowerIadd,
+        LowerIsub,
+        LowerIaddi,
+        LowerIand,
+        LowerIor,
+        LowerMove,
+        LowerMr32,
+        LowerLqi,
+        LowerSqi,
+        LowerMtir,
+        LowerMfir,
+        LowerB,
+        LowerIbeq,
+        LowerIbne,
+        LowerIbltz,
+        LowerIbgtz,
+        LowerIblez,
+        LowerIbgez,
+    };
+
+    struct Pair
+    {
+        const DecodedInstructionPair *decoded = nullptr;
+        uint16_t pc = 0;
+        // Every VF result of the block up to this pair is due by this many
+        // cycles after the block starts.
+        uint16_t vfLandBy = 0;
+        uint8_t stall = 0;
+        bool simple = false;       // no I bit and no shadowed register: the ops below apply
+        bool control = false;      // runs the pc, branch and E bit logic
+        bool readsFlags = false;   // an FC, FM or FS op: the flags due by now land first
+        bool queuesEvent = false;  // queues Q, P or a slow VI write
+        bool startsXgkick = false;
+        bool keepDeclared = false; // an op run() relies on issueVfWrite to trim
+        bool slow = false;         // not simple or keepDeclared: execCompiledPair
+        bool special = false;      // readsFlags, queuesEvent or startsXgkick
+        UpperOp upperOp = UpperCall;
+        LowerOp lowerOp = LowerCall;
+        uint8_t writtenVi = 0;
+        uint8_t viLatency = 0;
+        bool delaysBranchRead = false;
+        // Lanes this pair writes with no result on its way: their old values
+        // are what run() shows until the results are due (m_vfShown).
+        uint8_t shownCount = 0;
+        std::array<uint8_t, 2> shownReg{};
+        std::array<uint8_t, 2> shownComponents{}; // x in bit 0
+        // Lower fields.
+        uint8_t vfS = 0, vfT = 0, viS = 0, viT = 0, viD = 0, dest = 0;
+        int16_t immediate = 0;
+        uint16_t branchTarget = 0;
+        CompiledFmac fmac{};
+        uint32_t upper = 0;
+        uint32_t lower = 0;
+        // The lower op reads the register the upper one writes, and nothing
+        // else ties them: the lower op runs first and sees the old value.
+        bool lowerFirst = false;
+        bool eBit = false;
+    };
+
+    enum class Exit : uint8_t
+    {
+        Continue,      // after a branch's delay slot, or the size limit
+        XgkickWait,    // stops before an XGKICK that may wait for the one before
+        Unsupported,   // stops before a pair this can't run
+    };
+
+    struct Block
+    {
+        uint32_t startPc = 0;
+        uint32_t entryTiming = 0;
+        bool delaySlot = false; // entered with a branch or E bit pending: the block is its delay slot
+        std::vector<Pair> pairs;
+        Exit exit = Exit::Continue;
+        uint32_t exitTiming = 0;
+        uint32_t cycles = 0; // stalls and issues
+        uint32_t endPc = 0;  // the pc after the last pair when it isn't a control pair
+        // The last two successors taken, to skip the lookup.
+        std::array<uint32_t, 2> nextPc{~0u, ~0u};
+        std::array<Block *, 2> next{};
+        uint64_t code = 0; // codeHash
+        GeneratedBlockFn generated = nullptr;
+    };
+
+    struct BlockKey
+    {
+        uint32_t pc; // with bit 16 for a delay slot
+        uint32_t timing;
+        bool operator==(const BlockKey &other) const { return pc == other.pc && timing == other.timing; }
+    };
+    struct BlockKeyHash
+    {
+        size_t operator()(const BlockKey &key) const { return (static_cast<size_t>(key.timing) << 17) ^ key.pc; }
+    };
+
+    // The code image these blocks were compiled from, and its decoded pairs,
+    // which the blocks point into.
+    std::vector<uint8_t> image;
+    std::vector<DecodedInstructionPair> decoded;
+    uint64_t lastUse = 0;
+    std::vector<VuTiming> timings;
+    std::unordered_map<VuTiming, uint32_t, VuTimingHash> timingIds;
+    std::unordered_map<BlockKey, std::unique_ptr<Block>, BlockKeyHash> blocks;
+
+    uint32_t intern(const VuTiming &timing)
+    {
+        const auto found = timingIds.find(timing);
+        if (found != timingIds.end())
+            return found->second;
+        const uint32_t id = static_cast<uint32_t>(timings.size());
+        timings.push_back(timing);
+        timingIds.emplace(timing, id);
+        return id;
+    }
+
+    static uint32_t stallFor(const VuTiming &timing, const DecodedInstructionPair &decoded)
+    {
+        const PairHazards &hazards = decoded.hazards;
+        uint32_t stall = 0;
+        for (uint32_t index = 0; index < hazards.vfReadCount; ++index)
+            stall = std::max<uint32_t>(stall, timing.vf[hazards.vfReads[index]]);
+        for (uint32_t regs = hazards.viReads; regs != 0u; regs &= regs - 1u)
+            stall = std::max<uint32_t>(stall, timing.vi[std::countr_zero(regs)]);
+        if ((hazards.scalarWaits & WaitQ) != 0u)
+            stall = std::max<uint32_t>(stall, timing.fdiv);
+        if ((hazards.scalarWaits & WaitEfu) != 0u)
+            stall = std::max<uint32_t>(stall, timing.efuResource);
+        if ((hazards.scalarWaits & WaitP) != 0u)
+            stall = std::max<uint32_t>(stall, std::max(timing.efu[0], timing.efu[1]));
+        return stall;
+    }
+
+    static void issue(VuTiming &timing, const DecodedInstructionPair &decoded)
+    {
+        const PairHazards &hazards = decoded.hazards;
+        for (uint32_t index = 0; index < hazards.vfWriteCount; ++index)
+            timing.vf[hazards.vfWrites[index]] = hazards.vfWriteLatency[index];
+        for (uint32_t regs = hazards.viWrites; regs != 0u; regs &= regs - 1u)
+            timing.vi[std::countr_zero(regs)] = hazards.viWriteLatency;
+        const InstructionUsage &lower = decoded.lowerUsage;
+        if (lower.pipeline == PipelineFdiv && !lower.waitQ)
+            timing.fdiv = lower.latency;
+        if (lower.pipeline == PipelineEfu && !lower.waitP)
+        {
+            // queueP takes the first free entry.
+            uint8_t &entry = timing.efu[0] == 0u ? timing.efu[0] : timing.efu[1];
+            entry = lower.latency;
+            timing.efuResource = static_cast<uint8_t>(lower.latency > 0u ? lower.latency - 1u : 0u);
+        }
+    }
+
+    static UpperOp upperOpFor(const DecodedInstructionPair &decoded, CompiledFmac &fmac)
+    {
+        if (decoded.upperNop)
+            return UpperNop;
+        if (decodeCompiledFmac(decoded.upper, fmac))
+            return UpperFmac;
+        const uint32_t upper = decoded.upper;
+        const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+        if (op < 0x3Cu)
+        {
+            // MAX and MINI.
+            if ((op >= 0x10u && op <= 0x17u) || op == 0x1Du || op == 0x1Fu || op == 0x2Bu || op == 0x2Fu)
+                return UpperVector;
+            return UpperCall;
+        }
+        const uint8_t special = static_cast<uint8_t>((upper & 0x3u) | ((upper >> 4) & 0x7Cu));
+        if ((special >= 0x10u && special <= 0x17u) || special == 0x1Du) // ITOF, FTOI, ABS
+            return UpperVector;
+        if (special == 0x1Fu)
+            return UpperClip;
+        return UpperCall;
+    }
+
+    static LowerOp lowerOpFor(uint32_t lower, Pair &pair)
+    {
+        if (isLowerNop(lower))
+            return LowerNop;
+        const uint8_t opHi = static_cast<uint8_t>((lower >> 25) & 0x7Fu);
+        const auto branch = [&](LowerOp op)
+        {
+            pair.branchTarget = static_cast<uint16_t>((pair.pc + 8u + static_cast<int32_t>(IMM11(lower)) * 8) & kVu1PcMask);
+            return op;
+        };
+        switch (opHi)
+        {
+        case 0x00: pair.immediate = IMM11(lower); return LowerLq;
+        case 0x01: pair.immediate = IMM11(lower); return LowerSq;
+        case 0x04: pair.immediate = IMM11(lower); return LowerIlw;
+        case 0x08:
+        case 0x09:
+            pair.immediate = static_cast<int16_t>((lower & 0x7FFu) | ((lower >> 10) & 0x7800u));
+            return opHi == 0x08 ? LowerIaddiu : LowerIsubiu;
+        case 0x12: return LowerFcand;
+        case 0x13: return LowerFcor;
+        case 0x20: return branch(LowerB);
+        case 0x28: return branch(LowerIbeq);
+        case 0x29: return branch(LowerIbne);
+        case 0x2C: return branch(LowerIbltz);
+        case 0x2D: return branch(LowerIbgtz);
+        case 0x2E: return branch(LowerIblez);
+        case 0x2F: return branch(LowerIbgez);
+        case 0x40: break;
+        default: return LowerCall;
+        }
+        switch (lower & 0x3Fu)
+        {
+        case 0x30: return LowerIadd;
+        case 0x31: return LowerIsub;
+        case 0x32:
+            pair.immediate = static_cast<int16_t>(static_cast<int32_t>(((lower >> 6) & 0x1Fu) << 27) >> 27);
+            return LowerIaddi;
+        case 0x34: return LowerIand;
+        case 0x35: return LowerIor;
+        case 0x3C:
+        case 0x3D:
+        case 0x3E:
+        case 0x3F: break;
+        default: return LowerCall;
+        }
+        switch ((lower & 0x3u) | ((lower >> 4) & 0x7Cu))
+        {
+        case 0x30: return LowerMove;
+        case 0x31: return LowerMr32;
+        case 0x34: return LowerLqi;
+        case 0x35: return LowerSqi;
+        case 0x3B: return LowerNop; // WAITQ: the stall is the whole op
+        case 0x3C: return LowerMtir;
+        case 0x3D: return LowerMfir;
+        case 0x7B: return LowerNop; // WAITP
+        default: return LowerCall;
+        }
+    }
+
+    static void decodePair(const DecodedInstructionPair &decoded, Pair &pair)
+    {
+        pair.upper = decoded.upper;
+        pair.lower = decoded.lower;
+        if (const uint32_t viWrites = decoded.lowerUsage.viWrite & 0xFFFEu)
+            pair.writtenVi = static_cast<uint8_t>(std::countr_zero(viWrites));
+        pair.viLatency = decoded.hazards.viWriteLatency;
+        pair.delaysBranchRead = decoded.lowerUsage.delaysNextBranchRead;
+        pair.eBit = decoded.eBit;
+        pair.simple = !decoded.iBit;
+        const InstructionUsage &lowerUsage = decoded.lowerUsage;
+        pair.queuesEvent = lowerUsage.pipeline == PipelineFdiv || lowerUsage.pipeline == PipelineEfu ||
+                           (pair.writtenVi != 0u && pair.viLatency > 1u);
+        pair.startsXgkick = lowerUsage.pipeline == PipelineXgkick;
+        const uint32_t lower = decoded.lower;
+        if (!decoded.iBit)
+        {
+            switch ((lower >> 25) & 0x7Fu)
+            {
+            case 0x10: case 0x12: case 0x13: case 0x1C: // FCEQ, FCAND, FCOR, FCGET
+            case 0x14: case 0x16: case 0x17:            // FSEQ, FSAND, FSOR
+            case 0x18: case 0x1A: case 0x1B:            // FMEQ, FMAND, FMOR
+                pair.readsFlags = true;
+                break;
+            default:
+                break;
+            }
+        }
+        if (pair.simple)
+        {
+            pair.vfS = FS(lower);
+            pair.vfT = FT(lower);
+            pair.viS = VIS(lower);
+            pair.viT = VIT(lower);
+            pair.viD = VID(lower);
+            pair.dest = DEST(lower);
+            pair.lowerOp = lowerOpFor(lower, pair);
+            if (const uint8_t shadow = decoded.upperVfShadowReg; shadow != 0u)
+            {
+                bool writesVf = false;
+                switch (pair.lowerOp)
+                {
+                case LowerCall:
+                    pair.simple = false;
+                    break;
+                case LowerLq: case LowerLqi: case LowerMove: case LowerMr32: case LowerMfir:
+                    writesVf = true;
+                    break;
+                default:
+                    break;
+                }
+                if (writesVf && (pair.vfT == 0u || pair.vfT == shadow ||
+                                 vfReadLanes(decoded.upperUsage, pair.vfT) != 0u))
+                    pair.simple = false;
+                pair.lowerFirst = pair.simple;
+            }
+        }
+        if (!pair.simple)
+        {
+            pair.lowerOp = LowerCall;
+            pair.keepDeclared = true;
+            return;
+        }
+
+        pair.upperOp = upperOpFor(decoded, pair.fmac);
+        pair.keepDeclared = (pair.upperOp == UpperCall && decoded.upperUsage.vfWrite.reg != 0u) ||
+                            (pair.lowerOp == LowerCall && decoded.lowerUsage.vfWrite.reg != 0u);
+    }
+
+    static bool supported(const DecodedInstructionPair &decoded)
+    {
+        return !decoded.upperUsage.reserved && !decoded.lowerUsage.reserved;
+    }
+
+    Block *compile(const DecodedInstructionPair *decodedCode, uint32_t codeSize, uint32_t pc, uint32_t timingId,
+                   bool delaySlot)
+    {
+        auto block = std::make_unique<Block>();
+        block->startPc = pc;
+        block->entryTiming = timingId;
+        block->delaySlot = delaySlot;
+        VuTiming timing = timings[timingId];
+        uint32_t offset = 0;
+        uint32_t landBy = 0;
+        bool inDelaySlot = delaySlot;
+        bool endAfterThis = delaySlot;
+        constexpr size_t kMaxPairs = 256;
+        while (true)
+        {
+            if (pc + 8u > codeSize || (pc & 7u) != 0u || pc / 8u >= kMaxDecodedPairs)
+            {
+                block->exit = Exit::Unsupported;
+                break;
+            }
+            const DecodedInstructionPair &decoded = decodedCode[pc / 8u];
+            const bool isBranch = decoded.lowerUsage.pipeline == PipelineBranch;
+            const bool isXgkick = decoded.lowerUsage.pipeline == PipelineXgkick;
+            if (!supported(decoded) || (inDelaySlot && (isBranch || decoded.eBit)))
+            {
+                block->exit = Exit::Unsupported;
+                break;
+            }
+            if (isXgkick && !block->pairs.empty())
+            {
+                block->exit = Exit::XgkickWait;
+                break;
+            }
+
+            Pair pair;
+            pair.decoded = &decoded;
+            pair.pc = static_cast<uint16_t>(pc);
+            decodePair(decoded, pair);
+            pair.control = isBranch || decoded.eBit || inDelaySlot;
+            pair.slow = !pair.simple || pair.keepDeclared;
+            pair.special = pair.readsFlags || pair.queuesEvent || pair.startsXgkick;
+            const uint32_t stall = stallFor(timing, decoded);
+            pair.stall = static_cast<uint8_t>(stall);
+            advanceTiming(timing, stall);
+            offset += stall;
+
+            const PairHazards &hazards = decoded.hazards;
+            uint32_t latency = 0;
+            for (uint32_t index = 0; index < hazards.vfWriteCount; ++index)
+            {
+                const uint8_t lane = hazards.vfWrites[index];
+                latency = std::max<uint32_t>(latency, hazards.vfWriteLatency[index]);
+                if (timing.vf[lane] != 0u)
+                    continue;
+                const uint8_t reg = static_cast<uint8_t>(lane / 4u);
+                uint32_t slot = 0;
+                while (slot < pair.shownCount && pair.shownReg[slot] != reg)
+                    ++slot;
+                if (slot == pair.shownCount)
+                {
+                    // A pair writes at most two registers.
+                    pair.shownReg[slot] = reg;
+                    ++pair.shownCount;
+                }
+                pair.shownComponents[slot] |= static_cast<uint8_t>(1u << (lane % 4u));
+            }
+            if (decoded.upperUsage.vfWrite.reg != 0u || decoded.lowerUsage.vfWrite.reg != 0u)
+                landBy = std::max(landBy, offset + std::max(latency, 1u));
+            pair.vfLandBy = static_cast<uint16_t>(landBy);
+
+            issue(timing, decoded);
+            advanceTiming(timing, 1u);
+            offset += 1u;
+            block->pairs.push_back(pair);
+
+            pc += 8u;
+            if (pc >= codeSize)
+                pc = 0u;
+            if (endAfterThis)
+                break;
+            if (isBranch || decoded.eBit)
+            {
+                // The delay slot runs, then the block ends.
+                inDelaySlot = true;
+                endAfterThis = true;
+                continue;
+            }
+            if (block->pairs.size() >= kMaxPairs)
+                break;
+        }
+        block->cycles = offset;
+        block->endPc = pc;
+        block->exitTiming = intern(timing);
+        if (!block->pairs.empty())
+        {
+            const uint32_t keyPc = block->startPc | (delaySlot ? 0x10000u : 0u);
+            block->code = codeHash(*block);
+            block->generated = findGeneratedBlock(block->code, keyPc, timingKey(timings[timingId]));
+            recordCompiledBlock(keyPc, block->code, timings[timingId]);
+        }
+        Block *result = block.get();
+        blocks.emplace(BlockKey{result->startPc | (delaySlot ? 0x10000u : 0u), timingId}, std::move(block));
+        return result;
+    }
+
+    // What a block's code depends on besides its entry timing: its pairs'
+    // words and where they sit. The pairs after it only decide where it ends.
+    static uint64_t codeHash(const Block &block)
+    {
+        uint64_t hash = kFnv1aSeed;
+        for (const Pair &pair : block.pairs)
+        {
+            const uint32_t words[3] = {pair.pc, pair.upper, pair.lower};
+            hash = fnv1a64(words, sizeof(words), hash);
+        }
+        return hash;
+    }
+
+    // The timing after the first count pairs of block.
+    uint32_t timingAfter(const Block &block, size_t count)
+    {
+        VuTiming timing = timings[block.entryTiming];
+        for (size_t index = 0; index < count; ++index)
+        {
+            advanceTiming(timing, block.pairs[index].stall);
+            issue(timing, *block.pairs[index].decoded);
+            advanceTiming(timing, 1u);
+        }
+        return intern(timing);
+    }
+
+    Block *find(const DecodedInstructionPair *decodedCode, uint32_t codeSize, uint32_t pc, uint32_t timingId,
+                bool delaySlot)
+    {
+        const auto found = blocks.find(BlockKey{pc | (delaySlot ? 0x10000u : 0u), timingId});
+        if (found != blocks.end())
+            return found->second.get();
+        return compile(decodedCode, codeSize, pc, timingId, delaySlot);
+    }
+};
+
+// The ops of a pair without an I bit or a shadowed register, decoded ahead.
+__attribute__((always_inline)) inline void VU1Interpreter::execSimpleOps(const void *pairPointer, uint8_t *vuData,
+                                                                         uint32_t dataSize, GS &gs, PS2Memory *memory)
+{
+    const CompiledCode::Pair &pair = *static_cast<const CompiledCode::Pair *>(pairPointer);
+    int32_t *vi = m_state.vi;
+    const auto execUpperOp = [&]() __attribute__((always_inline))
+    {
+        switch (pair.upperOp)
+        {
+        case CompiledCode::UpperNop:
+            break;
+        case CompiledCode::UpperFmac:
+            if (!execFmacCompiled(pair.fmac))
+                execUpper(pair.upper);
+            break;
+        case CompiledCode::UpperVector:
+            m_currentUpperInstruction = pair.upper;
+            execUpperVector(pair.upper);
+            break;
+        case CompiledCode::UpperClip:
+            m_currentUpperInstruction = pair.upper;
+            execClip(pair.upper);
+            break;
+        default:
+            execUpper(pair.upper);
+            break;
+        }
+    };
+    if (!pair.lowerFirst)
+        execUpperOp();
+
+    const uint32_t addressMask = dataSize - 1u;
+    const auto takeBranch = [&]()
+    {
+        m_state.branchPending = true;
+        m_state.branchTarget = pair.branchTarget;
+        m_state.branchDelay = 1;
+    };
+    switch (pair.lowerOp)
+    {
+    case CompiledCode::LowerNop:
+        break;
+    case CompiledCode::LowerLq:
+        blendLanes(m_state.vf[pair.vfT],
+                   reinterpret_cast<const float *>(vuData + ((static_cast<uint32_t>(vi[pair.viS] + pair.immediate) * 16u) & addressMask)),
+                   pair.dest);
+        break;
+    case CompiledCode::LowerSq:
+        // Stores land as they issue in a compiled run (queueStore).
+        if (m_xgkick.active)
+            catchUpXgkick();
+        blendLanes(reinterpret_cast<float *>(vuData + ((static_cast<uint32_t>(vi[pair.viT] + pair.immediate) * 16u) & addressMask)),
+                   m_state.vf[pair.vfS], pair.dest);
+        break;
+    case CompiledCode::LowerIlw:
+    {
+        const uint32_t address = (static_cast<uint32_t>(vi[pair.viS] + pair.immediate) * 16u) & addressMask;
+        const uint32_t component = (pair.dest & 0x8u) ? 0u : (pair.dest & 0x4u) ? 1u : (pair.dest & 0x2u) ? 2u : 3u;
+        uint32_t word;
+        std::memcpy(&word, vuData + address + component * 4u, 4);
+        if (pair.viT != 0u)
+            vi[pair.viT] = static_cast<int16_t>(word & 0xFFFFu);
+        break;
+    }
+    case CompiledCode::LowerIaddiu:
+        if (pair.viT != 0u)
+            vi[pair.viT] = static_cast<int16_t>(vi[pair.viS] + pair.immediate);
+        break;
+    case CompiledCode::LowerIsubiu:
+        if (pair.viT != 0u)
+            vi[pair.viT] = static_cast<int16_t>(vi[pair.viS] - pair.immediate);
+        break;
+    case CompiledCode::LowerFcand:
+        vi[1] = (m_state.clip & (pair.lower & 0xFFFFFFu)) != 0u ? 1 : 0;
+        break;
+    case CompiledCode::LowerFcor:
+        vi[1] = ((m_state.clip | (pair.lower & 0xFFFFFFu)) == 0xFFFFFFu) ? 1 : 0;
+        break;
+    case CompiledCode::LowerIadd:
+        if (pair.viD != 0u)
+            vi[pair.viD] = static_cast<int16_t>(vi[pair.viS] + vi[pair.viT]);
+        break;
+    case CompiledCode::LowerIsub:
+        if (pair.viD != 0u)
+            vi[pair.viD] = static_cast<int16_t>(vi[pair.viS] - vi[pair.viT]);
+        break;
+    case CompiledCode::LowerIaddi:
+        if (pair.viT != 0u)
+            vi[pair.viT] = static_cast<int16_t>(vi[pair.viS] + pair.immediate);
+        break;
+    case CompiledCode::LowerIand:
+        if (pair.viD != 0u)
+            vi[pair.viD] = vi[pair.viS] & vi[pair.viT];
+        break;
+    case CompiledCode::LowerIor:
+        if (pair.viD != 0u)
+            vi[pair.viD] = vi[pair.viS] | vi[pair.viT];
+        break;
+    case CompiledCode::LowerMove:
+    {
+        float value[4];
+        std::memcpy(value, m_state.vf[pair.vfS], sizeof(value));
+        blendLanes(m_state.vf[pair.vfT], value, pair.dest);
+        break;
+    }
+    case CompiledCode::LowerMr32:
+    {
+        const float *source = m_state.vf[pair.vfS];
+        const float value[4] = {source[1], source[2], source[3], source[0]};
+        blendLanes(m_state.vf[pair.vfT], value, pair.dest);
+        break;
+    }
+    case CompiledCode::LowerLqi:
+        blendLanes(m_state.vf[pair.vfT],
+                   reinterpret_cast<const float *>(vuData + ((static_cast<uint32_t>(static_cast<uint16_t>(vi[pair.viS])) * 16u) & addressMask)),
+                   pair.dest);
+        if (pair.viS != 0u)
+            vi[pair.viS] = static_cast<int16_t>(vi[pair.viS] + 1);
+        break;
+    case CompiledCode::LowerSqi:
+        if (m_xgkick.active)
+            catchUpXgkick();
+        blendLanes(reinterpret_cast<float *>(vuData + ((static_cast<uint32_t>(static_cast<uint16_t>(vi[pair.viT])) * 16u) & addressMask)),
+                   m_state.vf[pair.vfS], pair.dest);
+        if (pair.viT != 0u)
+            vi[pair.viT] = static_cast<int16_t>(vi[pair.viT] + 1);
+        break;
+    case CompiledCode::LowerMtir:
+    {
+        uint32_t bits;
+        std::memcpy(&bits, &m_state.vf[pair.vfS][(pair.lower >> 21) & 0x3u], 4);
+        if (pair.viT != 0u)
+            vi[pair.viT] = static_cast<int16_t>(bits & 0xFFFFu);
+        break;
+    }
+    case CompiledCode::LowerMfir:
+    {
+        const int32_t value = static_cast<int16_t>(vi[pair.viS] & 0xFFFF);
+        float lanes[4];
+        std::memcpy(&lanes[0], &value, 4);
+        lanes[1] = lanes[2] = lanes[3] = lanes[0];
+        blendLanes(m_state.vf[pair.vfT], lanes, pair.dest);
+        break;
+    }
+    case CompiledCode::LowerB:
+        takeBranch();
+        break;
+    case CompiledCode::LowerIbeq:
+        if (static_cast<int16_t>(readBranchVi(pair.viS)) == static_cast<int16_t>(readBranchVi(pair.viT)))
+            takeBranch();
+        break;
+    case CompiledCode::LowerIbne:
+        if (static_cast<int16_t>(readBranchVi(pair.viS)) != static_cast<int16_t>(readBranchVi(pair.viT)))
+            takeBranch();
+        break;
+    case CompiledCode::LowerIbltz:
+        if (static_cast<int16_t>(readBranchVi(pair.viS)) < 0)
+            takeBranch();
+        break;
+    case CompiledCode::LowerIbgtz:
+        if (static_cast<int16_t>(readBranchVi(pair.viS)) > 0)
+            takeBranch();
+        break;
+    case CompiledCode::LowerIblez:
+        if (static_cast<int16_t>(readBranchVi(pair.viS)) <= 0)
+            takeBranch();
+        break;
+    case CompiledCode::LowerIbgez:
+        if (static_cast<int16_t>(readBranchVi(pair.viS)) >= 0)
