+    // Returns the offset just past the GIF packet (the tag with EOP set and its data) that starts at pos,
+    // or size if no tag in [pos, size) ends a packet.
+    size_t gifPacketEnd(const uint8_t *data, size_t size, size_t pos, bool &endsPacket)
+    {
+        endsPacket = false;
+        while (pos + 16u <= size)
+        {
+            uint64_t tagLo = 0;
+            std::memcpy(&tagLo, data + pos, sizeof(tagLo));
+            const uint64_t nloop = tagLo & 0x7FFFull;
+            const bool eop = ((tagLo >> 15) & 0x1ull) != 0ull;
+            const uint32_t flg = static_cast<uint32_t>((tagLo >> 58) & 0x3ull);
+            uint64_t nreg = (tagLo >> 60) & 0xFull;
+            if (nreg == 0ull)
+                nreg = 16ull;
+            uint64_t dataQw = nloop;
+            if (flg == GIF_FMT_PACKED)
+                dataQw = nloop * nreg;
+            else if (flg == GIF_FMT_REGLIST)
+                dataQw = (nloop * nreg + 1ull) / 2ull;
+            pos += 16u + static_cast<size_t>(std::min<uint64_t>(dataQw * 16ull, size - pos - 16u));
+            if (eop)
+            {
+                endsPacket = true;
+                return pos;
+            }
+        }
+        return size;
+    }
