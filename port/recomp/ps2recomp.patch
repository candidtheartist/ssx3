+void VU1Interpreter::commitCompiledEvents()
+{
+    // What commitReadyPipelines does at each of those cycles, but flags,
+    // which land before Q there, only as far as Q needs them.
+    while (true)
+    {
+        uint64_t cycle = std::numeric_limits<uint64_t>::max();
+        if (m_fdiv.valid)
+            cycle = m_fdiv.readyCycle;
+        for (const ScalarPipelineEntry &entry : m_efu)
+            if (entry.valid)
+                cycle = std::min(cycle, entry.readyCycle);
+        for (uint32_t slots = m_viWritePending; slots != 0u; slots &= slots - 1u)
+            cycle = std::min(cycle, m_viWritePipeline[std::countr_zero(slots)].readyCycle);
+        if (cycle > m_cycle)
+            break;
+
+        if (m_fdiv.valid && m_fdiv.readyCycle <= cycle)
+        {
+            commitFlagsUpTo(cycle);
+            m_state.q = m_fdiv.value;
+            const uint32_t currentDi = m_fdiv.statusDi & 0x30u;
+            m_state.status = (m_state.status & 0xFCFu) | currentDi | (currentDi << 6);
+            m_fdiv = {};
+        }
+        for (ScalarPipelineEntry &entry : m_efu)
+        {
+            if (entry.valid && entry.readyCycle <= cycle)
+            {
+                m_state.p = entry.value;
+                entry = {};
+            }
+        }
+        for (uint32_t slots = m_viWritePending; slots != 0u; slots &= slots - 1u)
+        {
+            const uint32_t slot = static_cast<uint32_t>(std::countr_zero(slots));
+            PendingViWrite &write = m_viWritePipeline[slot];
+            if (write.readyCycle > cycle)
+                continue;
+            if (m_viLatestWrite[write.reg] == write.sequence)
+                m_state.vi[write.reg] = static_cast<int16_t>(write.value);
+            m_dueSlots[write.readyCycle % kDueWheelSize].viWrites &= ~(1u << slot);
+            write = {};
+            m_viWritePending &= ~(1u << slot);
+        }
+    }
+
+    uint64_t nextScalar = std::numeric_limits<uint64_t>::max();
+    if (m_fdiv.valid)
+        nextScalar = m_fdiv.readyCycle;
+    for (const ScalarPipelineEntry &entry : m_efu)
+        if (entry.valid)
+            nextScalar = std::min(nextScalar, entry.readyCycle);
+    m_nextScalarCommit = nextScalar;
+    uint64_t nextVi = ~0ull;
+    for (uint32_t slots = m_viWritePending; slots != 0u; slots &= slots - 1u)
+        nextVi = std::min(nextVi, m_viWritePipeline[std::countr_zero(slots)].readyCycle);
+    m_compiledNextVi = nextVi;
+    m_compiledNextEvent = std::min(nextScalar, nextVi);
+}
+
+void VU1Interpreter::execCompiledPair(const void *pairPointer, uint8_t *vuData, uint32_t dataSize,
+                                      GS &gs, PS2Memory *memory, bool &programEnded)
+{
+    const CompiledCode::Pair &pair = *static_cast<const CompiledCode::Pair *>(pairPointer);
+    const DecodedInstructionPair &decoded = *pair.decoded;
+    saveShownValues(pairPointer);
+    if (pair.control)
+        m_state.pc = pair.pc;
+
+    const uint8_t writtenVi = pair.writtenVi;
+    int32_t *vi = m_state.vi;
+    const int32_t oldVi = vi[writtenVi];
+
+    const VfAccess upperWrite = decoded.upperUsage.vfWrite;
+    const VfAccess lowerWrite = decoded.lowerUsage.vfWrite;
+    const bool hasUpperWrite = upperWrite.reg != 0u;
+    const bool hasLowerWrite = lowerWrite.reg != 0u && decoded.suppressedLowerVf != lowerWrite.reg;
+    const bool hasDistinctLowerWrite = hasLowerWrite && (!hasUpperWrite || lowerWrite.reg != upperWrite.reg);
+    alignas(16) float oldUpperVf[4]{};
+    alignas(16) float oldLowerVf[4]{};
+    if (pair.keepDeclared)
+    {
+        if (hasUpperWrite)
+            std::memcpy(oldUpperVf, m_state.vf[upperWrite.reg], sizeof(oldUpperVf));
+        if (hasDistinctLowerWrite)
+            std::memcpy(oldLowerVf, m_state.vf[lowerWrite.reg], sizeof(oldLowerVf));
+    }
+
+    if (pair.simple)
+        execSimpleOps(pairPointer, vuData, dataSize, gs, memory);
+    else if (decoded.iBit)
+    {
+        if (!decoded.upperNop)
+            execUpper(decoded.upper);
+        float immediate = 0.0f;
+        std::memcpy(&immediate, &decoded.lower, sizeof(immediate));
+        m_state.i = normalizeOperand(immediate);
+    }
+    else
+    {
+        // The lower op reads or writes the register the upper one writes.
+        float oldVf[4]{};
+        float upperVf[4]{};
+        std::memcpy(oldVf, m_state.vf[decoded.upperVfShadowReg], sizeof(oldVf));
+        execUpper(decoded.upper);
+        std::memcpy(upperVf, m_state.vf[decoded.upperVfShadowReg], sizeof(upperVf));
+        std::memcpy(m_state.vf[decoded.upperVfShadowReg], oldVf, sizeof(oldVf));
+        if (!isLowerNop(decoded.lower))
+            execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);
+        std::memcpy(m_state.vf[decoded.upperVfShadowReg], upperVf, sizeof(upperVf));
+    }
+
+    m_viBranchBackupValid = false;
+    if (pair.keepDeclared)
+    {
+        if (hasUpperWrite)
+            keepDeclaredLanes(m_state.vf[upperWrite.reg], oldUpperVf, upperWrite.lanes);
+        if (hasDistinctLowerWrite)
+            keepDeclaredLanes(m_state.vf[lowerWrite.reg], oldLowerVf, lowerWrite.lanes);
+    }
+    if (writtenVi != 0u)
+    {
+        if (pair.viLatency <= 1u)
+        {
+            vi[writtenVi] = static_cast<int16_t>(vi[writtenVi]);
+            m_viLatestWrite[writtenVi] = ++m_nextWriteSequence;
+        }
+        else
+        {
+            const int32_t newVi = vi[writtenVi];
+            vi[writtenVi] = oldVi;
+            queueViWrite(writtenVi, newVi, pair.viLatency);
+        }
+        if (pair.delaysBranchRead)
+            recordViWriteForBranch(writtenVi, oldVi);
+    }
+
+    _mm_storeu_ps(m_state.vf[0], _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f));
+    vi[0] = 0;
+
+    if (pair.control)
+        finishControlPair(decoded.eBit, programEnded);
+}
+
+bool VU1Interpreter::runCompiled(uint8_t *vuCode, uint32_t codeSize,
+                                 uint8_t *vuData, uint32_t dataSize,
+                                 GS &gs, PS2Memory *memory, uint32_t maxCycles)
+{
+    if (m_unit != Unit::VU1 || m_state.dBitEnabled || m_state.tBitEnabled || maxCycles == 0u)
+        return false;
+    if (codeSize > kVu1PcMask + 1u)
+        return false;
+    if (!memory || vuCode != memory->getVU1Code())
+        return false;
+    CompiledCode *compiledImage = compiledCodeFor(vuCode, codeSize, memory);
+    if (!compiledImage)
+        return false;
+    CompiledCode &compiled = *compiledImage;
+    const DecodedInstructionPair *decodedCode = compiled.decoded.data();
+    m_compiledCodeSize = codeSize;
+
+    m_activeVuData = vuData;
+    m_activeVuDataSize = dataSize;
+    m_activeGs = &gs;
+    m_activeMemory = memory;
+    const int previousRoundingMode = ps2_host_fpu::getRounding();
+    const bool useVuRounding = ps2_host_fpu::setRounding(FE_TOWARDZERO);
+    const uint64_t budgetEnd = m_cycle + maxCycles;
+    m_compiledRun = true;
+    m_compiledNextVi = ~0ull;
+    m_compiledNextEvent = m_nextScalarCommit;
+    m_xgkickProgressCycle = m_cycle;
+
+    // The program starts with nothing on its way (execute resets the scheduler).
+    CompiledCode::Block *block = compiled.find(decodedCode, codeSize, m_state.pc, 0u, false);
+    bool programEnded = false;
+    bool outOfBudget = false; // handing off before a pair that can't issue in time
+    uint32_t handOffTiming = 0;
+    while (true)
+    {
+        if (block->pairs.empty())
+        {
+            handOffTiming = block->entryTiming;
+            break;
+        }
+        if (block->pairs.front().startsXgkick && m_xgkick.active)
+        {
+            // XGKICK waits for the transfer before it; the wait sets the timing.
+            catchUpXgkick();
+            uint32_t waited = 0;
+            bool outOfCycles = false;
+            while (m_xgkick.active)
+            {
+                if (m_cycle + 1u >= budgetEnd)
+                {
+                    outOfCycles = true;
+                    break;
+                }
+                ++m_cycle;
+                ++waited;
+                ++m_xgkickProgressCycle;
+                progressXgkick();
+            }
+            if (waited != 0u || outOfCycles)
+            {
+                VuTiming timing = compiled.timings[block->entryTiming];
+                advanceTiming(timing, waited);
+                const uint32_t timingId = compiled.intern(timing);
+                if (outOfCycles)
+                {
+                    handOffTiming = timingId;
+                    break;
+                }
+                block = compiled.find(decodedCode, codeSize, block->startPc, timingId, block->delaySlot);
+                continue;
+            }
+        }
+
+        const uint64_t blockStart = m_cycle;
+        const bool nearBudget = m_cycle + block->cycles >= budgetEnd;
+        const size_t count = block->pairs.size();
+        size_t index = 0;
+        bool cut = false; // the interpreter takes over before pairs[index]
+        if (block->generated && !nearBudget)
+        {
+            const uint32_t result = block->generated(*this, block->pairs.data(), vuData, dataSize, gs, memory,
+                                                     programEnded);
+            index = result & ~kGeneratedCut;
+            cut = (result & kGeneratedCut) != 0u;
+        }
+        else
+        {
+            for (; index < count; ++index)
+            {
+                const CompiledCode::Pair &pair = block->pairs[index];
+                if (nearBudget && m_cycle + pair.stall >= budgetEnd)
+                {
+                    outOfBudget = true;
+                    cut = true;
+                    break;
+                }
+                if (!VU1CompiledAccess::step(*this, pair, vuData, dataSize, gs, memory, programEnded))
+                {
+                    if (!programEnded)
+                    {
+                        ++index;
+                        cut = true;
+                    }
+                    break;
+                }
+            }
+        }
+        if (programEnded)
+        {
+            m_vfLandBy = std::max<uint64_t>(m_vfLandBy, blockStart + block->pairs[index].vfLandBy);
+            break;
+        }
+        if (cut)
+        {
+            if (index != 0u)
+            {
+                const CompiledCode::Pair &previous = block->pairs[index - 1u];
+                m_vfLandBy = std::max<uint64_t>(m_vfLandBy, blockStart + previous.vfLandBy);
+                if (!previous.control)
+                    m_state.pc = index < count ? block->pairs[index].pc : block->endPc;
+            }
+            handOffTiming = compiled.timingAfter(*block, index);
+            break;
+        }
+        const CompiledCode::Pair &last = block->pairs.back();
+        m_vfLandBy = std::max<uint64_t>(m_vfLandBy, blockStart + last.vfLandBy);
+        if (!last.control)
+            m_state.pc = block->endPc;
+        if (block->exit == CompiledCode::Exit::Unsupported)
+        {
+            handOffTiming = block->exitTiming;
+            break;
+        }
+
+        // Only a block cut short before an XGKICK can end with a branch or
+        // E bit pending; the next one is then its delay slot.
+        const bool pending = m_state.branchPending || m_state.ebit;
+        const uint32_t pc = m_state.pc | (pending ? 0x10000u : 0u);
+        if (block->nextPc[0] == pc)
+            block = block->next[0];
+        else if (block->nextPc[1] == pc)
+            block = block->next[1];
+        else
+        {
+            CompiledCode::Block *next = compiled.find(decodedCode, codeSize, m_state.pc, block->exitTiming, pending);
+            const uint32_t slot = block->nextPc[0] == ~0u ? 0u : 1u;
+            block->nextPc[slot] = pc;
+            block->next[slot] = next;
+            block = next;
+        }
+    }
+
+    // As run() would have them at this cycle boundary.
+    commitCompiledEvents();
+    commitFlagsUpTo(m_cycle);
+    catchUpXgkick();
+    m_compiledRun = false;
+    if (programEnded)
+    {
+        flushPipelines();
+        m_state.ebit = false;
+        m_state.haltAfterDelaySlot = false;
+        m_pendingHaltD = false;
+        m_pendingHaltT = false;
+        m_state.cycles = m_cycle;
+        if (useVuRounding && previousRoundingMode != -1)
+            ps2_host_fpu::setRounding(previousRoundingMode);
+        return true;
+    }
+
+    // The interpreter takes over here, with the timing it would have had.
+    const VuTiming &timing = compiled.timings[handOffTiming];
+    for (uint32_t lane = 0; lane < 128u; ++lane)
+        m_vfReady[lane] = m_cycle + timing.vf[lane];
+    for (uint32_t reg = 0; reg < 16u; ++reg)
+        m_viReady[reg] = m_cycle + timing.vi[reg];
+    m_state.cycles = m_cycle;
+    // A stop raised while the next pair stalled doesn't skip it in run(),
+    // but this one can't issue before the budget runs out anyway.
+    if (m_stopRequested && outOfBudget)
+        advanceTo(budgetEnd);
+    if (useVuRounding && previousRoundingMode != -1)
+        ps2_host_fpu::setRounding(previousRoundingMode);
+    run(vuCode, codeSize, vuData, dataSize, gs, memory, static_cast<uint32_t>(budgetEnd - m_cycle));
+    return true;
+}
+
+#else
+
+bool VU1Interpreter::runCompiled(uint8_t *, uint32_t, uint8_t *, uint32_t, GS &, PS2Memory *, uint32_t)
+{
+    return false;
+}
+
+#endif
