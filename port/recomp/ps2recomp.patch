+    struct PageExtent
+    {
+        uint32_t width;
+        uint32_t height;
+    };
+
+    PageExtent pageExtent(uint32_t psm)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            return {64u, 64u};
+        case GS_PSM_T8:
+            return {128u, 64u};
+        case GS_PSM_T4:
+            return {128u, 128u};
+        default:
+            return {64u, 32u};
+        }
+    }
+
+    // Two buffers with the same layout put each pixel at the same address, so the same
+    // worker draws it whichever of them a draw goes through.
+    uint32_t layoutKey(uint32_t block, uint32_t bw, uint32_t psm)
+    {
+        if (psm == GS_PSM_CT24)
+            psm = GS_PSM_CT32;
+        else if (psm == GS_PSM_Z24)
+            psm = GS_PSM_Z32;
+        return 0x80000000u | (block & 0x3FFFu) | ((bw & 0x3Fu) << 14u) | ((psm & 0x3Fu) << 20u);
+    }
+
+    int clampToInt(float value, int lo, int hi)
+    {
+        if (!(value >= static_cast<float>(lo)))
+            return lo;
+        if (!(value <= static_cast<float>(hi)))
+            return hi;
+        return static_cast<int>(value);
+    }
+
+    // The texel coordinates, before wrapping, that a primitive's vertices span. False
+    // when they can't be bounded.
+    bool texelBounds(const GSPrimitiveBatch &batch, size_t vertexCount,
+                     float &minU, float &maxU, float &minV, float &maxV)
+    {
+        const GSDrawState &state = batch.state;
+        const float width = static_cast<float>(state.textureWidth);
+        const float height = static_cast<float>(state.textureHeight);
+        float minQ = 0.0f;
+        float maxQ = 0.0f;
+        for (size_t i = 0; i < vertexCount; ++i)
+        {
+            const GSVertex &v = batch.vertices[i];
+            float u;
+            float t;
+            if (state.prim.fst)
+            {
+                u = static_cast<float>(v.u) / 16.0f;
+                t = static_cast<float>(v.v) / 16.0f;
+            }
+            else
+            {
+                // S/Q and T/Q stay between their values at the vertices only while Q
+                // keeps one sign.
+                if (!(v.q > 1.0e-8f))
+                    return false;
+                u = v.s / v.q * width;
+                t = v.t / v.q * height;
+                minQ = i == 0 ? v.q : std::min(minQ, v.q);
+                maxQ = i == 0 ? v.q : std::max(maxQ, v.q);
+            }
+            minU = i == 0 ? u : std::min(minU, u);
+            maxU = i == 0 ? u : std::max(maxU, u);
+            minV = i == 0 ? t : std::min(minV, t);
+            maxV = i == 0 ? t : std::max(maxV, t);
+        }
