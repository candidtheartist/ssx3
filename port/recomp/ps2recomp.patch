diff --git a/ps2xRuntime/src/lib/ps2_vu1_thread.cpp b/ps2xRuntime/src/lib/ps2_vu1_thread.cpp
new file mode 100644
index 0000000..b3e6b0d
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_vu1_thread.cpp
@@ -0,0 +1,127 @@
+#include "runtime/ps2_vu1_thread.h"
+
+#include "ThreadNaming.h"
+#include "runtime/ps2_host_fpu.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <exception>
+#include <utility>
+
+Vu1Thread::Vu1Thread()
+{
+    m_thread = std::thread([this]
+                           { Run(); });
+    m_threadId = m_thread.get_id();
+}
+
+Vu1Thread::~Vu1Thread()
+{
+    {
+        std::lock_guard<ps2_host_sync::Mutex> lock(m_mutex);
+        m_stop = true;
+    }
+    m_jobReady.notify_all();
+    m_thread.join();
+}
+
+void Vu1Thread::Submit(std::function<void()> job, size_t bytes)
+{
+    Job entry;
+    entry.run = std::move(job);
+    entry.bytes = bytes;
+    entry.roundingMode = ps2_host_fpu::getRounding();
+
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_mutex);
+    // A job bigger than the limit still goes in, once the queue has drained.
+    if (!hasRoomFor(bytes))
+    {
+        m_roomWanted = bytes;
+        m_jobDone.wait(lock, [&]
+                       { return hasRoomFor(bytes); });
+        m_roomWanted = SIZE_MAX;
+    }
+    m_pendingBytes += bytes;
+    m_jobs.push_back(std::move(entry));
+    m_submitted.fetch_add(1u, std::memory_order_relaxed);
+    const bool wake = m_idle;
+    m_idle = false;
+    lock.unlock();
+    if (wake)
+        m_jobReady.notify_one();
+}
+
+bool Vu1Thread::hasRoomFor(size_t bytes) const
+{
+    return m_pendingBytes == 0u || m_pendingBytes + bytes <= kMaxPendingBytes;
+}
+
+void Vu1Thread::WaitIdle()
+{
+    // Only the submitting thread waits, so it reads its own count.
+    WaitFor(m_submitted.load(std::memory_order_relaxed));
+}
+
+void Vu1Thread::VsyncFence()
+{
+    const uint64_t oldest = m_vsyncMarks[m_nextVsyncMark];
+    m_vsyncMarks[m_nextVsyncMark] = m_submitted.load(std::memory_order_relaxed);
+    m_nextVsyncMark = (m_nextVsyncMark + 1u) % kVsyncsAhead;
+    WaitFor(oldest);
+}
+
+void Vu1Thread::WaitFor(uint64_t sequence)
+{
+    if (m_completed.load(std::memory_order_acquire) >= sequence)
+        return;
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_mutex);
+    ++m_completionWaiters;
+    m_waitTarget = std::min(m_waitTarget, sequence);
+    m_jobDone.wait(lock, [&]
+                   { return m_completed.load(std::memory_order_relaxed) >= sequence; });
+    if (--m_completionWaiters == 0u)
+        m_waitTarget = UINT64_MAX;
+}
+
+void Vu1Thread::Run()
+{
+    ThreadNaming::SetCurrentThreadName("Vu1Thread");
+    for (;;)
+    {
+        Job job;
+        {
+            std::unique_lock<ps2_host_sync::Mutex> lock(m_mutex);
+            if (!m_stop && m_jobs.empty())
+            {
+                m_idle = true;
+                m_jobReady.wait(lock, [&]
+                                { return m_stop || !m_jobs.empty(); });
+                m_idle = false;
+            }
+            if (m_jobs.empty())
+                return;
+            job = std::move(m_jobs.front());
+            m_jobs.pop_front();
+        }
+
+        ps2_host_fpu::setRounding(job.roundingMode);
+        try
+        {
+            job.run();
+        }
+        catch (const std::exception &error)
+        {
+            std::fprintf(stderr, "[vu1-thread] job failed: %s\n", error.what());
+        }
+
+        bool wake = false;
+        {
+            std::lock_guard<ps2_host_sync::Mutex> lock(m_mutex);
+            m_pendingBytes -= job.bytes;
+            const uint64_t completed = m_completed.fetch_add(1u, std::memory_order_release) + 1u;
+            wake = completed >= m_waitTarget || (m_roomWanted != SIZE_MAX && hasRoomFor(m_roomWanted));
+        }
+        if (wake)
+            m_jobDone.notify_all();
+    }
+}
