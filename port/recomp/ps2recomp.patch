+bool GSThreadedBackend::PageTracker::Intersects(const PageSet &a, const PageSet &b)
+{
+    uint64_t any = 0;
+    for (size_t i = 0; i < a.size(); ++i)
+        any |= a[i] & b[i];
+    return any != 0u;
+}
+
+void GSThreadedBackend::PageTracker::Clear()
+{
+    m_drawn.fill(0u);
+    m_refreshed.fill(0u);
+    m_uploaded.fill(0u);
+}
+
+bool GSThreadedBackend::PageTracker::Conflicts(const Access *drawn, size_t count, const PageSet &refreshed) const
+{
+    // Copying pages another worker may still be drawing to, or the first worker may
+    // still be writing a transfer to.
+    if (Intersects(refreshed, m_drawn) || Intersects(refreshed, m_uploaded))
+        return true;
+
+    for (size_t i = 0; i < count; ++i)
+    {
+        // Drawing to pages another worker may still be copying, or the first worker
+        // may still be writing a transfer to.
+        if (Intersects(drawn[i].pages, m_refreshed) || Intersects(drawn[i].pages, m_uploaded))
+            return true;
+
+        // Drawing through another layout puts pixels on rows another worker draws.
+        for (size_t word = 0; word < drawn[i].pages.size(); ++word)
+        {
+            uint64_t both = drawn[i].pages[word] & m_drawn[word];
+            while (both != 0u)
+            {
+                const uint32_t page = static_cast<uint32_t>(word * 64u) + static_cast<uint32_t>(__builtin_ctzll(both));
+                if (m_layout[page] != drawn[i].layout)
+                    return true;
+                both &= both - 1u;
+            }
+        }
+    }
+    return false;
+}
+
+void GSThreadedBackend::PageTracker::Add(const Access *drawn, size_t count, const PageSet &refreshed)
+{
+    for (size_t word = 0; word < m_refreshed.size(); ++word)
+        m_refreshed[word] |= refreshed[word];
+
+    for (size_t i = 0; i < count; ++i)
+    {
+        for (size_t word = 0; word < m_drawn.size(); ++word)
+        {
+            uint64_t fresh = drawn[i].pages[word] & ~m_drawn[word];
+            while (fresh != 0u)
+            {
+                const uint32_t page = static_cast<uint32_t>(word * 64u) + static_cast<uint32_t>(__builtin_ctzll(fresh));
+                m_layout[page] = drawn[i].layout;
+                fresh &= fresh - 1u;
+            }
+            m_drawn[word] |= drawn[i].pages[word];
+        }
+    }
+}
+
+bool GSThreadedBackend::PageTracker::UploadConflicts(const PageSet &pages) const
+{
+    // The first worker writes the transfer to VRAM as well, perhaps before or after
+    // another worker draws there or copies the page.
+    return Intersects(pages, m_drawn) || Intersects(pages, m_refreshed);
+}
+
+void GSThreadedBackend::PageTracker::AddUpload(const PageSet &pages)
+{
+    for (size_t word = 0; word < m_uploaded.size(); ++word)
+        m_uploaded[word] |= pages[word];
+}
+
+void GSThreadedBackend::BarrierCompletion::operator()() noexcept
+{
+    const uint64_t begin = self->m_aloneBegin;
+    const Command &first = self->m_ring[begin % kRingSize];
+    const uint64_t end = first.runAlone ? self->aloneRunEnd(begin) : begin;
+    self->m_aloneEnd = end;
+    for (uint64_t i = begin; i < end; ++i)
+    {
+        const Command &command = self->m_ring[i % kRingSize];
+        try
+        {
+            for (size_t worker = 0; worker < self->m_workers.size(); ++worker)
+                self->refreshTextureCopy(worker, command.refresh);
+            if (command.runAlone)
+            {
+                self->runAlone(command);
+            }
+            else
+            {
+                for (size_t worker = 0; worker < self->m_workers.size(); ++worker)
+                    self->runCommand(worker, command);
+            }
+        }
+        catch (...)
+        {
+            // A failed command must not take the workers, and every later draw, with it.
+        }
+    }
+}
+
+GSThreadedBackend::GSThreadedBackend(unsigned workerCount)
+    : m_barrier(static_cast<std::ptrdiff_t>(std::max(workerCount, 1u)), BarrierCompletion{this})
+{
+    const unsigned count = std::max(workerCount, 1u);
+    m_workers.resize(count);
+    m_ring.resize(kRingSize);
+    m_progress = std::make_unique<WorkerProgress[]>(count);
+    m_sleep = std::make_unique<WorkerSleep[]>(count);
+    m_runPrimitives.resize(kRunPrimitives);
+    for (unsigned i = 0; i < count; ++i)
+    {
+        m_workers[i].backend = std::make_unique<GSCpuBackend>();
+        m_workers[i].backend->SetRowBand(i, count);
+    }
+    for (size_t i = 0; i < m_workers.size(); ++i)
+        m_workers[i].thread = std::thread([this, i]() { workerMain(i); });
+}
+
+GSThreadedBackend::~GSThreadedBackend()
+{
+    waitForQueuedWork();
+    {
+        std::lock_guard<ps2_host_sync::Mutex> lock(m_wakeMutex);
+        m_stopping = true;
+        for (size_t i = 0; i < m_workers.size(); ++i)
+            m_sleep[i].wake.notify_one();
+    }
+    for (Worker &worker : m_workers)
+    {
+        if (worker.thread.joinable())
+            worker.thread.join();
+    }
+}
+
+GSThreadedBackend::Command &GSThreadedBackend::beginCommand(std::unique_lock<ps2_host_sync::Mutex> &lock, CommandKind kind, bool mayWait)
+{
+    closeRun();
+    const uint64_t submitted = m_submitted.load(std::memory_order_relaxed);
+    if (mayWait && submitted >= kMaxPendingCommands && completedCommands() + kMaxPendingCommands <= submitted)
+        waitForCompleted(lock, submitted - kMaxPendingCommands + kRefillCommands);
+    // The wait lets go of m_queueMutex, so another thread may have queued a command in
+    // the meantime (a presentation request never waits for room).
+    Command &command = m_ring[m_submitted.load(std::memory_order_relaxed) % kRingSize];
+    command = Command{};
+    command.kind = kind;
+    command.roundingMode = ps2_host_fpu::getRounding();
+    command.runBegin = m_nextRunPrimitive;
+    command.runEnd = m_nextRunPrimitive;
+    return command;
+}
+
+void GSThreadedBackend::endCommand(std::unique_lock<ps2_host_sync::Mutex> &lock)
+{
+    publishCommand();
+    lock.unlock();
+}
+
+void GSThreadedBackend::publishCommand()
+{
+    // Workers already awake see the command at once. Idle ones are woken for a batch,
+    // for a command they all wait at, and before anything waits for them (so a short
+    // batch never waits long: the presentation request comes every frame and wakes them).
+    const Command &command = m_ring[m_submitted.load(std::memory_order_relaxed) % kRingSize];
+    m_submitted.fetch_add(1u);
+    m_unwokenCommands += 1u + (command.runEnd - command.runBegin);
+    if (m_unwokenCommands >= kWakeBatch || command.waitForAll || command.runAlone)
+        wakeIdleWorkers();
+}
+
+void GSThreadedBackend::closeRun()
+{
+    if (m_runOpen)
+    {
+        m_runOpen = false;
+        publishCommand();
+    }
+}
+
+void GSThreadedBackend::waitForRunRoom(std::unique_lock<ps2_host_sync::Mutex> &lock)
+{
+    for (;;)
+    {
+        // The oldest primitive still needed is the first of the oldest command a worker
+        // hasn't run yet, or of the open run.
+        const uint64_t submitted = m_submitted.load(std::memory_order_relaxed);
+        const uint64_t completed = completedCommands();
+        uint64_t oldest = m_nextRunPrimitive;
+        if (completed < submitted || m_runOpen)
+            oldest = m_ring[completed % kRingSize].runBegin;
+        if (m_nextRunPrimitive - oldest < kRunPrimitives)
+            return;
+        // The open run holds at most kMaxRunLength of them, so the queued commands do.
+        waitForCompleted(lock, completed + std::max<uint64_t>(1u, (submitted - completed) / 2u));
+    }
+}
+
+void GSThreadedBackend::wakeIdleWorkers() const
+{
+    m_unwokenCommands = 0;
+    // A worker counts itself idle before it looks for commands, and commands are published
+    // before this reads the count, so a worker either sees them or is counted here. It
+    // looks and goes to sleep with m_wakeMutex held, so the wakeup can't fall in between.
+    if (m_idleWorkers.load() != 0u)
+    {
+        std::lock_guard<ps2_host_sync::Mutex> lock(m_wakeMutex);
+        ++m_wakeRound;
+        wakeNextWorker(SIZE_MAX);
+    }
+}
+
+void GSThreadedBackend::wakeNextWorker(size_t self) const
+{
+    // A round reaches each worker at most once, so workers woken with nothing to do
+    // can't keep waking each other.
+    for (size_t i = 0; i < m_workers.size(); ++i)
+    {
+        WorkerSleep &sleep = m_sleep[i];
+        if (i != self && sleep.sleeping && !sleep.woken && sleep.round != m_wakeRound)
+        {
+            sleep.woken = true;
+            sleep.round = m_wakeRound;
+            sleep.wake.notify_one();
+            return;
+        }
+    }
+}
+
+uint64_t GSThreadedBackend::completedCommands() const
+{
+    uint64_t completed = m_progress[0].done.load();
+    for (size_t i = 1; i < m_workers.size(); ++i)
+        completed = std::min(completed, m_progress[i].done.load());
+    return completed;
+}
+
+void GSThreadedBackend::waitForCompleted(std::unique_lock<ps2_host_sync::Mutex> &lock, uint64_t target) const
+{
+    if (completedCommands() >= target)
+        return;
+    wakeIdleWorkers();
+    // The target is lowered before the waiter count goes up, so a worker that sees the
+    // count also sees a target no higher than this one. Both change only with
+    // m_queueMutex held.
+    uint64_t lowest = m_completionTarget.load();
+    while (target < lowest && !m_completionTarget.compare_exchange_weak(lowest, target))
+    {
+    }
+    m_completionWaiters.fetch_add(1u);
+    m_workDone.wait(lock, [this, target]() { return completedCommands() >= target; });
+    if (m_completionWaiters.fetch_sub(1u) == 1u)
+        m_completionTarget.store(UINT64_MAX);
+}
+
+void GSThreadedBackend::notifyCompleted()
+{
+    // A waiter registers before checking the workers' progress, and a worker publishes
+    // its progress before checking for waiters, so one of them sees the other.
+    if (m_completionWaiters.load() != 0u && completedCommands() >= m_completionTarget.load())
+    {
+        std::lock_guard<ps2_host_sync::Mutex> lock(m_queueMutex);
+        m_workDone.notify_all();
+    }
+}
+
+void GSThreadedBackend::waitForQueuedWork() const
+{
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+    // The calls that return VRAM contents are const, but the primitives of an open run
+    // are drawn before them.
+    const_cast<GSThreadedBackend *>(this)->closeRun();
+    waitForCompleted(lock, m_submitted.load());
+}
+
+void GSThreadedBackend::markRunAlone(DrawPlan &plan)
+{
+    plan.runAlone = true;
+    m_pages.Clear();
+}
+
+uint32_t GSThreadedBackend::workersForRows(int y0, int y1) const
+{
+    // GSCpuBackend::SetRowBand: worker i draws the bands of rows whose number modulo the
+    // worker count is i.
+    const uint32_t count = static_cast<uint32_t>(m_workers.size());
+    const uint32_t first = static_cast<uint32_t>(std::max(y0, 0)) >> GSCpuBackend::kRowBandShift;
+    const uint32_t last = static_cast<uint32_t>(std::max(y1, 0)) >> GSCpuBackend::kRowBandShift;
+    if (last - first + 1u >= count)
+        return ~0u;
+    uint32_t workers = 0u;
+    for (uint32_t band = first; band <= last; ++band)
+        workers |= 1u << (band % count);
+    return workers;
+}
+
+void GSThreadedBackend::markDrawn(const PageTracker::PageSet &pages)
+{
+    for (size_t word = 0; word < m_stale.size(); ++word)
+        m_stale[word] |= pages[word];
+}
+
+void GSThreadedBackend::refreshTextureCopy(size_t worker, const PageTracker::PageSet &pages)
+{
+    constexpr uint32_t kPageBytes = 8192u;
+    uint8_t *const copy = m_textureCopies.size() > worker ? m_textureCopies[worker].get() : nullptr;
+    if (!copy)
+        return;
+    for (size_t word = 0; word < pages.size(); ++word)
+    {
+        uint64_t bits = pages[word];
+        while (bits != 0u)
+        {
+            const uint32_t page = static_cast<uint32_t>(word * 64u) + static_cast<uint32_t>(__builtin_ctzll(bits));
+            const size_t offset = static_cast<size_t>(page) * kPageBytes;
+            if (offset + kPageBytes <= m_vramSize)
+                std::memcpy(copy + offset, m_vram + offset, kPageBytes);
+            bits &= bits - 1u;
+        }
+    }
+}
+
+void GSThreadedBackend::readTexturesFromVram(size_t worker, bool fromVram)
+{
+    uint8_t *const copy = m_textureCopies.size() > worker ? m_textureCopies[worker].get() : nullptr;
+    if (copy)
+        m_workers[worker].backend->SetTextureMemory(fromVram ? nullptr : copy, worker == 0u);
+}
+
+uint64_t GSThreadedBackend::aloneRunEnd(uint64_t begin) const
+{
+    // Nothing between them draws, so the workers have nothing to do in between.
+    // SSX 3 sends a texture's mip levels as one transfer each, with a texture
+    // flush after each and a CLUT load after the last.
+    const uint64_t submitted = m_submitted.load();
+    uint64_t end = begin + 1u;
+    while (end < submitted)
+    {
+        const Command &next = m_ring[end % kRingSize];
+        if (!next.runAlone && next.kind != CommandKind::LoadClut && next.kind != CommandKind::TextureFlush)
+            break;
+        ++end;
+    }
+    return end;
+}
+
+void GSThreadedBackend::classifyDraw(DrawPlan &plan, const PageTracker::Access *drawn, size_t count,
+                                     const PageTracker::PageSet &textured, bool readsOwnPixels)
+{
+    if (m_workers.size() <= 1u)
+        return;
+
+    // A draw that textures from its own target, or whose colour and depth buffers
+    // share pages, depends on the order its own pixels are drawn in. One whose pixels
+    // each read only themselves from the colour buffer (drawn[0]) does not.
+    bool alone = false;
+    for (size_t i = 0; i < count && !alone; ++i)
+    {
+        alone = !(readsOwnPixels && i == 0u) && PageTracker::Intersects(drawn[i].pages, textured);
+        for (size_t j = i + 1u; j < count && !alone; ++j)
+            alone = PageTracker::Intersects(drawn[i].pages, drawn[j].pages);
+    }
+    if (alone)
+    {
+        // The first worker reads its textures from VRAM.
+        for (size_t i = 0; i < count; ++i)
+            markDrawn(drawn[i].pages);
+        markRunAlone(plan);
+        return;
+    }
+
+    // Its own worker drew every pixel it reads, in VRAM, unless an earlier draw reached
+    // those pages through another layout, which Conflicts checks. Nothing else can need
+    // what it reads.
+    static const PageTracker::PageSet kNoPages{};
+    const PageTracker::PageSet &reads = readsOwnPixels ? kNoPages : textured;
+    plan.texturesFromVram = readsOwnPixels;
+
+    // Pages drawn to since the copies last had them are copied to each worker's copy
+    // before it runs the plan. Unless Conflicts says to wait, those draws were
+    // before the workers last waited for each other, so they are done.
+    for (size_t word = 0; word < reads.size(); ++word)
+    {
+        plan.refresh[word] = reads[word] & m_stale[word];
+        m_stale[word] &= ~plan.refresh[word];
+    }
+    if (m_pages.Conflicts(drawn, count, plan.refresh))
+    {
+        plan.waitForAll = true;
+        m_pages.Clear();
+    }
+    m_pages.Add(drawn, count, plan.refresh);
+    for (size_t i = 0; i < count; ++i)
+        markDrawn(drawn[i].pages);
+}
+
+void GSThreadedBackend::classifySubmit(const GSPrimitiveBatch &batch, DrawPlan &plan)
+{
+    if (m_workers.size() <= 1u)
+        return;
+
+    const GSDrawState &state = batch.state;
+    const GSContext &ctx = state.context;
+
+    size_t vertexCount = 0;
+    switch (state.prim.type)
+    {
+    case GS_PRIM_POINT:
+        vertexCount = 1u;
+        break;
+    case GS_PRIM_LINE:
+    case GS_PRIM_LINESTRIP:
+    case GS_PRIM_SPRITE:
+        vertexCount = 2u;
+        break;
+    case GS_PRIM_TRIANGLE:
+    case GS_PRIM_TRISTRIP:
+    case GS_PRIM_TRIFAN:
+        vertexCount = 3u;
+        break;
+    default:
+        return;
+    }
+
+    // The rows and columns the primitive can touch, with a pixel to spare each side.
+    const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+    const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+    float minX = batch.vertices[0].x - ofx;
+    float maxX = minX;
+    float minY = batch.vertices[0].y - ofy;
+    float maxY = minY;
+    for (size_t i = 1; i < vertexCount; ++i)
+    {
+        const float x = batch.vertices[i].x - ofx;
+        const float y = batch.vertices[i].y - ofy;
+        minX = std::min(minX, x);
+        maxX = std::max(maxX, x);
+        minY = std::min(minY, y);
+        maxY = std::max(maxY, y);
+    }
+    const int x0 = std::max<int>(clampToInt(std::floor(minX) - 1.0f, -1, 4096), ctx.scissor.x0);
+    const int x1 = std::min<int>(clampToInt(std::ceil(maxX) + 1.0f, -1, 4096), ctx.scissor.x1);
+    const int y0 = std::max<int>(clampToInt(std::floor(minY) - 1.0f, -1, 4096), ctx.scissor.y0);
+    const int y1 = std::min<int>(clampToInt(std::ceil(maxY) + 1.0f, -1, 4096), ctx.scissor.y1);
+
+    PageTracker::Access drawn[2]{};
+    size_t drawnCount = 0;
+    const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+    if (x0 <= x1 && y0 <= y1)
+    {
+        const uint32_t fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+        drawn[drawnCount].layout = layoutKey(fbp, fbw, ctx.frame.psm);
+        PageTracker::AddPages(drawn[drawnCount].pages, fbp, fbw, ctx.frame.psm, x0, y0, x1, y1);
+        ++drawnCount;
+
+        const uint32_t ztestMethod = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+        if (ztestMethod >= 2u || (ztestMethod == 1u && !ctx.zbuf.zmask))
+        {
+            const uint32_t zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+            drawn[drawnCount].layout = layoutKey(zbp, fbw, ctx.zbuf.psm);
+            PageTracker::AddPages(drawn[drawnCount].pages, zbp, fbw, ctx.zbuf.psm, x0, y0, x1, y1);
+            ++drawnCount;
+        }
+        plan.workers = workersForRows(y0, y1);
+    }
+    else
+    {
+        // Outside the scissor: no worker draws a pixel of it.
+        plan.workers = 0u;
+    }
+
+    // A copy of the target onto itself reads exactly the pixels it draws.
+    const bool readsOwnPixels = drawnCount != 0u && readsOnlyItsOwnPixels(batch);
+    PageTracker::PageSet textured{};
+    if (readsOwnPixels)
+    {
+        textured = drawn[0].pages;
+    }
+    else if (state.prim.tme && drawnCount != 0u)
+    {
+        // A UV sprite's texels can be found exactly, with the maths DrawSprite uses (this
+        // runs in the rounding mode the draw will).
+        float minU = 0.0f, maxU = 0.0f, minV = 0.0f, maxV = 0.0f;
+        int spriteU0, spriteU1, spriteV0, spriteV1;
+        bool bounded = GSCpuBackend::SpriteTexelRange(batch, spriteU0, spriteU1, spriteV0, spriteV1);
+        if (bounded)
+        {
+            minU = static_cast<float>(spriteU0);
+            maxU = static_cast<float>(spriteU1);
+            minV = static_cast<float>(spriteV0);
+            maxV = static_cast<float>(spriteV1);
+        }
+        else
+        {
+            bounded = texelBounds(batch, vertexCount, minU, maxU, minV, maxV);
+        }
+        const uint64_t clamp = ctx.clamp;
+        int u0, u1, v0, v1;
+        wrapTexelRange(minU, maxU, bounded, std::max<int>(state.textureWidth, 1), clamp & 3u,
+                       static_cast<int>((clamp >> 4) & 0x3FFu), static_cast<int>((clamp >> 14) & 0x3FFu), u0, u1);
+        wrapTexelRange(minV, maxV, bounded, std::max<int>(state.textureHeight, 1), (clamp >> 2) & 3u,
+                       static_cast<int>((clamp >> 24) & 0x3FFu), static_cast<int>((clamp >> 34) & 0x3FFu), v0, v1);
+        PageTracker::AddPages(textured, ctx.tex0.tbp0, ctx.tex0.tbw, ctx.tex0.psm, u0, v0, u1, v1);
+    }
+
+    classifyDraw(plan, drawn, drawnCount, textured, readsOwnPixels);
+}
+
+void GSThreadedBackend::runCommand(size_t worker, const Command &command)
+{
+    GSCpuBackend &backend = *m_workers[worker].backend;
+    ps2_host_fpu::setRounding(command.roundingMode);
+
+    switch (command.kind)
+    {
+    case CommandKind::Submit:
+    {
+        if (command.texturesFromVram)
+            readTexturesFromVram(worker, true);
+        if (command.runAlone || ((command.firstWorkers >> worker) & 1u))
+            backend.Submit(command.batch);
+        if (command.runEnd != command.runBegin)
+        {
+            GSPrimitiveBatch batch = command.batch;
+            for (uint64_t i = command.runBegin; i != command.runEnd; ++i)
+            {
+                const RunPrimitive &primitive = m_runPrimitives[i % kRunPrimitives];
+                if (((primitive.workers >> worker) & 1u) == 0u)
+                    continue;
+                batch.vertices = primitive.vertices;
+                batch.vertexCount = primitive.vertexCount;
+                backend.Submit(batch);
+            }
+        }
+        if (command.texturesFromVram)
+            readTexturesFromVram(worker, false);
+        break;
+    }
+    case CommandKind::LoadClut:
+        backend.LoadClut(command.tex0, command.texclut);
+        break;
+    case CommandKind::BeginTransfer:
+        backend.BeginTransfer(command.transfer);
+        break;
+    case CommandKind::UploadImage:
+        backend.UploadImage(command.data.data(), static_cast<uint32_t>(command.data.size()));
+        break;
+    case CommandKind::TextureFlush:
+        backend.TextureFlush();
+        break;
+    case CommandKind::ClearFramebuffer:
+        backend.ClearFramebuffer(command.batch.state.context, command.args[0]);
+        break;
+    default:
+        break;
+    }
+
+    if (worker == 0u && (command.kind == CommandKind::BeginTransfer || command.kind == CommandKind::UploadImage))
+    {
+        const GSTransferSnapshot snapshot = backend.GetTransferSnapshot();
+        std::lock_guard<ps2_host_sync::Mutex> lock(m_transferMutex);
+        m_transferSnapshot = snapshot;
+    }
+}
+
+void GSThreadedBackend::runAlone(const Command &command)
+{
+    GSCpuBackend &backend = *m_workers[0].backend;
+    ps2_host_fpu::setRounding(command.roundingMode);
+
+    switch (command.kind)
+    {
+    case CommandKind::Submit:
+    case CommandKind::ClearFramebuffer:
+        // It may read what it draws, so it reads VRAM.
+        backend.SetRowBand(0u, 1u);
+        readTexturesFromVram(0u, true);
+        runCommand(0u, command);
+        readTexturesFromVram(0u, false);
+        backend.SetRowBand(0u, static_cast<uint32_t>(m_workers.size()));
+        break;
+    case CommandKind::BeginTransfer:
+    {
+        // A local to local or local to host transfer, which reads and writes only
+        // VRAM. The other workers just end any host to local transfer they were in.
+        backend.BeginTransfer(command.transfer);
+        GSTransferCommand ended = command.transfer;
+        ended.direction = 3u;
+        for (size_t worker = 1; worker < m_workers.size(); ++worker)
+            m_workers[worker].backend->BeginTransfer(ended);
+        break;
+    }
+    case CommandKind::WriteVram:
+        backend.WriteVram(command.args[0], command.args[1], command.args[2], command.args[3], command.args[4], command.args[5]);
+        break;
+    case CommandKind::Present:
+    {
+        PresentationFrame frame = backend.Present(m_presentRequest);
+        {
+            std::lock_guard<ps2_host_sync::Mutex> lock(m_presentMutex);
+            m_lastPresented = std::move(frame);
+            m_presentQueued = false;
+        }
+        break;
+    }
+    default:
+        break;
+    }
+
+    if (command.kind == CommandKind::BeginTransfer)
+    {
+        const GSTransferSnapshot snapshot = backend.GetTransferSnapshot();
+        std::lock_guard<ps2_host_sync::Mutex> lock(m_transferMutex);
+        m_transferSnapshot = snapshot;
+    }
+}
+
+void GSThreadedBackend::workerMain(size_t index)
+{
+    std::atomic<uint64_t> &done = m_progress[index].done;
+    const unsigned spins = ps2_host_sync::spinCount();
+    uint64_t next = 0;
+    for (;;)
+    {
+        if (next == m_submitted.load())
+        {
+            // The next commands usually come within microseconds, and going to sleep and
+            // being woken for them costs more than looking again for a while first.
+            for (unsigned spin = 0; spin < spins && next == m_submitted.load(std::memory_order_relaxed); ++spin)
+                ps2_host_sync::spinPause();
+            if (next != m_submitted.load())
+                continue;
+            std::unique_lock<ps2_host_sync::Mutex> lock(m_wakeMutex);
+            WorkerSleep &sleep = m_sleep[index];
+            ++m_idleWorkers;
+            sleep.sleeping = true;
+            for (;;)
+            {
+                if (sleep.woken)
+                {
+                    sleep.woken = false;
+                    wakeNextWorker(index);
+                }
+                if (m_stopping || m_submitted.load() != next)
+                    break;
+                sleep.wake.wait(lock);
+            }
+            sleep.sleeping = false;
+            --m_idleWorkers;
+            if (m_submitted.load() == next)
+                return;
+            continue;
+        }
+
+        const Command &command = m_ring[next % kRingSize];
+        if (command.waitForAll || command.runAlone)
+        {
+            const bool alone = command.runAlone;
+            if (index == 0u)
+                m_aloneBegin = next;
+            m_barrier.arrive_and_wait();
+            if (alone)
+            {
+                // The barrier ran the commands up to m_aloneEnd. Their slots can be
+                // reused as soon as this is published, so don't read them again.
+                next = m_aloneEnd;
+                done.store(next);
+                notifyCompleted();
+                continue;
+            }
+        }
+        try
+        {
+            refreshTextureCopy(index, command.refresh);
+            if ((command.workers >> index) & 1u)
+                runCommand(index, command);
+        }
+        catch (...)
+        {
+            // A failed draw must not take the worker, and every later draw, with it.
+        }
+        done.store(++next);
+        notifyCompleted();
+    }
+}
+
+void GSThreadedBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    waitForQueuedWork();
+    m_vram = vram;
+    m_vramSize = vram ? vramSize : 0u;
+    m_textureCopies.clear();
+    m_textureCopies.resize(m_workers.size());
+    for (size_t i = 0; i < m_workers.size(); ++i)
+    {
+        m_workers[i].backend->Initialize(vram, vramSize);
+        if (m_workers.size() > 1u && vram)
+        {
+            m_textureCopies[i] = std::make_unique<uint8_t[]>(vramSize);
+            std::memcpy(m_textureCopies[i].get(), vram, vramSize);
+            readTexturesFromVram(i, false);
+        }
+    }
+    {
+        std::lock_guard<ps2_host_sync::Mutex> lock(m_queueMutex);
+        m_stale.fill(0u);
+    }
+    std::lock_guard<ps2_host_sync::Mutex> lock(m_transferMutex);
+    m_transferSnapshot = m_workers[0].backend->GetTransferSnapshot();
+}
+
+void GSThreadedBackend::Reset()
+{
+    waitForQueuedWork();
+    for (Worker &worker : m_workers)
+        worker.backend->Reset();
+    std::lock_guard<ps2_host_sync::Mutex> lock(m_transferMutex);
+    m_transferSnapshot = m_workers[0].backend->GetTransferSnapshot();
+}
+
+void GSThreadedBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+    waitForRunRoom(lock);
+    DrawPlan plan;
+    classifySubmit(batch, plan);
+    const int roundingMode = ps2_host_fpu::getRounding();
+
+    // A primitive joins the open run when the workers would run it straight after the
+    // run's others anyway: no waiting for each other first, no pages to copy first.
+    if (m_runOpen)
+    {
+        Command &run = m_ring[m_submitted.load(std::memory_order_relaxed) % kRingSize];
+        if (!plan.waitForAll && !plan.runAlone && noPages(plan.refresh) &&
+            plan.texturesFromVram == run.texturesFromVram && run.roundingMode == roundingMode &&
+            run.runEnd - run.runBegin + 1u < kMaxRunLength && run.batch.state == batch.state)
+        {
+            RunPrimitive &primitive = m_runPrimitives[m_nextRunPrimitive % kRunPrimitives];
+            primitive.vertices = batch.vertices;
+            primitive.vertexCount = batch.vertexCount;
+            primitive.workers = plan.workers;
+            run.runEnd = ++m_nextRunPrimitive;
+            run.workers |= plan.workers;
+            if (run.runEnd - run.runBegin + 1u >= kMaxRunLength)
+                closeRun();
+            return;
+        }
+    }
+
+    Command &command = beginCommand(lock, CommandKind::Submit);
+    static_cast<DrawPlan &>(command) = plan;
+    command.firstWorkers = plan.workers;
+    command.batch = batch;
+    if (command.runAlone)
+        publishCommand();
+    else
+        m_runOpen = true;
+}
+
+void GSThreadedBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::LoadClut);
+    command.tex0 = tex0;
+    command.texclut = texclut;
+    if (m_workers.size() > 1u)
+    {
+        // Every worker loads its own copy of the CLUT from VRAM.
+        PageTracker::PageSet textured{};
+        if (tex0.csm == 0u)
+            PageTracker::AddPages(textured, tex0.cbp, 1u, tex0.cpsm, 0, 0, 15, 15);
+        else
+            PageTracker::AddPages(textured, tex0.cbp, texclut.cbw != 0u ? texclut.cbw : 1u, tex0.cpsm,
+                                  texclut.cou * 16, texclut.cov, texclut.cou * 16 + 255, texclut.cov);
+        classifyDraw(command, nullptr, 0u, textured, false);
+    }
+    endCommand(lock);
+}
+
+void GSThreadedBackend::BeginTransfer(const GSTransferCommand &transfer)
+{
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::BeginTransfer);
+    command.transfer = transfer;
+    const GSBitBltBuf &buffers = transfer.bitbltbuf;
+    const int rrw = static_cast<int>(transfer.trxreg.rrw);
+    const int rrh = static_cast<int>(transfer.trxreg.rrh);
+    if (transfer.direction == 0u)
+    {
+        // Every worker writes it to the memory it reads textures from, while the
+        // others draw.
+        if (m_workers.size() > 1u)
+        {
+            PageTracker::PageSet pages{};
+            PageTracker::AddPages(pages, buffers.dbp, std::max<uint32_t>(buffers.dbw, 1u), buffers.dpsm,
+                                  transfer.trxpos.dsax, transfer.trxpos.dsay,
+                                  transfer.trxpos.dsax + rrw - 1, transfer.trxpos.dsay + rrh - 1);
+            if (m_pages.UploadConflicts(pages))
+            {
+                command.waitForAll = true;
+                m_pages.Clear();
+            }
+            m_pages.AddUpload(pages);
+        }
+    }
+    else if (transfer.direction == 1u || transfer.direction == 2u)
+    {
+        if (transfer.direction == 2u)
+        {
+            PageTracker::PageSet pages{};
+            PageTracker::AddPages(pages, buffers.dbp, std::max<uint32_t>(buffers.dbw, 1u), buffers.dpsm,
+                                  transfer.trxpos.dsax, transfer.trxpos.dsay,
+                                  transfer.trxpos.dsax + rrw - 1, transfer.trxpos.dsay + rrh - 1);
+            markDrawn(pages);
+        }
+        markRunAlone(command);
+    }
+    m_lastTransferCommand = m_submitted.load() + 1u;
+    endCommand(lock);
+}
+
+void GSThreadedBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::unique_lock<ps2_host_sync::Mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::UploadImage);
+    if (data && sizeBytes != 0u)
+        command.data.assign(data, data + sizeBytes);
+    m_lastTransferCommand = m_submitted.load() + 1u;
+    endCommand(lock);
+}
