+// Compiled blocks for VU1 programs.
+//
+// The interpreter (run()) is the spec: a compiled run must leave the same
+// registers, flags, VU memory, GS packets and cycle count. What makes blocks
+// possible is that stalls depend only on the pipeline timing (how many cycles
+// each queued result still needs), not on values. A block is compiled for
+// one start pc and one entry timing, so every pair's stall is known ahead;
+// values still flow at run time through the interpreter's own op code or the
+// pre-decoded fast paths below.
+//
+// Anything a block can't run (D/T bits, reserved ops, the end of the cycle
+// budget, a stop) hands over to run() at a pair boundary with the pipeline
+// timing rebuilt, so run() carries on as if it had run the whole program.
+
+#include "runtime/ps2_vu1.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_host_fpu.h"
+#include "ps2_vu1_detail.h"
+
+#include <algorithm>
+#include <bit>
+#include <cfenv>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <vector>
+
+void VU1Interpreter::commitFlagsUpTo(uint64_t cycle)
+{
+    uint32_t head = m_flagHead;
+    uint32_t count = m_flagCount;
+    if (count == 0u || m_flagPipeline[head].readyCycle > cycle)
+        return;
+    uint32_t mac = m_state.mac;
+    uint32_t status = m_state.status;
+    uint32_t clip = m_state.clip;
+    for (; count != 0u && m_flagPipeline[head].readyCycle <= cycle; --count)
+    {
+        const FlagPipelineEntry &entry = m_flagPipeline[head];
+        mac = (mac & entry.macKeep) | entry.macSet;
+        status = (status & entry.statusKeep) | entry.statusSet;
+        clip = (clip & entry.clipKeep) | entry.clipSet;
+        head = (head + 1u) % kMaxFlagEntries;
+    }
+    m_state.mac = mac;
+    m_state.status = status;
+    m_state.clip = clip;
+    m_flagHead = head;
+    m_flagCount = count;
+}
