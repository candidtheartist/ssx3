+// Compiled VU1 blocks: the block structures and the per-pair code, shared by
+// ps2_vu1_compiled.cpp and the generated block functions.
+#pragma once
+
+#include "runtime/ps2_vu1.h"
+#include "ps2_vu1_detail.h"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdio>
