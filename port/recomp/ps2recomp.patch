diff --git a/ps2xRuntime/include/runtime/ps2_vu1_thread.h b/ps2xRuntime/include/runtime/ps2_vu1_thread.h
new file mode 100644
index 0000000..935924d
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_vu1_thread.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+#include "runtime/ps2_host_sync.h"
+
+// Runs VIF1 lists, the VU1 microprograms they start and the GIF packets they and GIF
+// DMA send, one job at a time in submission order, on its own thread, so the EE can
+// keep going meanwhile. Each job runs in the rounding mode its submitter had. Before
+// the EE side reads or changes anything a job may touch (VIF1 and VU1 state, the GIF
+// arbiter, the GS frontend and the GS registers the GIF writes), it calls WaitIdle.
+class Vu1Thread
+{
+public:
+    Vu1Thread();
+    ~Vu1Thread();
+
+    Vu1Thread(const Vu1Thread &) = delete;
+    Vu1Thread &operator=(const Vu1Thread &) = delete;
+
+    // Submit, WaitIdle and VsyncFence are called from one thread, the EE's.
+    // bytes is the data the job carries: past kMaxPendingBytes the submitter waits.
+    void Submit(std::function<void()> job, size_t bytes);
+    // Returns once every submitted job has finished.
+    void WaitIdle();
+    // Called at each vertical blank. Returns once every job submitted before the
+    // kVsyncsAhead-th previous call has finished, so the EE stays at most that many
+    // vertical blanks ahead of what has been drawn.
+    void VsyncFence();
+    bool OnThread() const { return std::this_thread::get_id() == m_threadId; }
+
+    static constexpr size_t kMaxPendingBytes = 32u << 20u;
+    static constexpr size_t kVsyncsAhead = 3u;
+
+private:
+    struct Job
+    {
+        std::function<void()> run;
+        size_t bytes = 0;
+        int roundingMode = 0;
+    };
+
+    void Run();
+    void WaitFor(uint64_t sequence);
+    bool hasRoomFor(size_t bytes) const; // with m_mutex held
+
+    ps2_host_sync::Mutex m_mutex;
+    ps2_host_sync::CondVar m_jobReady;
+    ps2_host_sync::CondVar m_jobDone;
+    std::deque<Job> m_jobs;
+    size_t m_pendingBytes = 0;
+    // Waking a thread costs a lot more than checking whether it needs waking (on Windows
+    // most of all), so the two threads only wake each other when the other is waiting
+    // for this. All of these change with m_mutex held.
+    bool m_idle = false;                // the job thread waits for a job
+    uint32_t m_completionWaiters = 0;   // threads waiting for jobs to finish
+    uint64_t m_waitTarget = UINT64_MAX; // the fewest finished jobs one of them waits for
+    size_t m_roomWanted = SIZE_MAX;     // the submitter waits for room for a job this big
+    std::atomic<uint64_t> m_submitted{0};
+    std::array<uint64_t, kVsyncsAhead> m_vsyncMarks{}; // the submitting thread's own
+    size_t m_nextVsyncMark = 0;
+    std::atomic<uint64_t> m_completed{0};
+    bool m_stop = false;
+    std::thread m_thread;
+    std::thread::id m_threadId;
+};
diff --git a/ps2xRuntime/include/runtime/ps2_x86_compat.h b/ps2xRuntime/include/runtime/ps2_x86_compat.h
new file mode 100644
index 0000000..e50bf59
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_x86_compat.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <immintrin.h>
+
+#if !defined(__x86_64__) && !defined(_M_X64)
+// 32-bit x86 has no 64-bit GPR <-> XMM moves; go through memory instead.
+static inline long long ps2x_cvtsi128_si64(__m128i v)
+{
+    long long out;
+    _mm_storel_epi64(reinterpret_cast<__m128i *>(&out), v);
+    return out;
+}
+static inline __m128i ps2x_cvtsi64_si128(long long v)
+{
+    return _mm_loadl_epi64(reinterpret_cast<const __m128i *>(&v));
+}
+static inline long long ps2x_extract_epi64(__m128i v, int index)
+{
+    return ps2x_cvtsi128_si64(index ? _mm_unpackhi_epi64(v, v) : v);
+}
+#define _mm_cvtsi128_si64(v) ps2x_cvtsi128_si64(v)
+#define _mm_cvtsi64_si128(v) ps2x_cvtsi64_si128(v)
+#define _mm_extract_epi64(v, i) ps2x_extract_epi64((v), (i))
+#endif
