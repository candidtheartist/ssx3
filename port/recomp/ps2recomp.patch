diff --git a/ps2xTest/include/vu1_fuzzer.h b/ps2xTest/include/vu1_fuzzer.h
new file mode 100644
index 0000000..75b971f
--- /dev/null
+++ b/ps2xTest/include/vu1_fuzzer.h
@@ -0,0 +1,192 @@
+// Random short VU1 programs on random states, for comparing compiled blocks
+// with the interpreter. Shared by the VU1 tests and the tool that generates
+// block code for them (vu1_test_blocks.cpp), which must run the same programs.
+#pragma once
+
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+
+#include <cstdint>
+#include <cstring>
+
+namespace vu1fuzz
+{
+    struct VuFuzzer
+    {
+        uint64_t state = 0;
+
+        uint64_t next()
+        {
+            uint64_t z = (state += 0x9E3779B97F4A7C15ull);
+            z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+            z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+            return z ^ (z >> 31);
+        }
+
+        uint32_t below(uint32_t n) { return static_cast<uint32_t>(next() % n); }
+
+        // Weighted towards the values whose flags or rounding are special.
+        uint32_t floatBits()
+        {
+            const uint32_t sign = below(2) << 31;
+            switch (below(14))
+            {
+            case 0: return sign;
+            case 1: return 0x7F800000u | sign;                         // infinity
+            case 2: return 0x7FC00000u | below(0x400000u) | sign;      // NaN
+            case 3: return below(0x800000u) | sign;                    // denormal
+            case 4: return (0x7F7FFFFFu - below(4u)) | sign;           // near FLT_MAX
+            case 5: return (0x00800000u + below(4u)) | sign;           // near FLT_MIN
+            case 6: return ((1u + below(30u)) << 23 | below(0x800000u)) | sign;
+            case 7: return ((225u + below(29u)) << 23 | below(0x800000u)) | sign;
+            case 8: return static_cast<uint32_t>(next());
+            case 9: return static_cast<uint32_t>(static_cast<int32_t>(below(200000u)) - 100000); // for ITOF
+            default:
+            {
+                const float value = (static_cast<float>(next() % 2000001u) - 1000000.0f) / 997.0f;
+                uint32_t bits = 0;
+                std::memcpy(&bits, &value, sizeof(bits));
+                return bits;
+            }
+            }
+        }
+
+        // No I, E, M, D or T bit.
+        uint32_t upper()
+        {
+            const uint32_t fields = (below(16u) << 21) | (below(32u) << 16) | (below(32u) << 11) | (below(32u) << 6);
+            if (below(8u) == 0u)
+                return 0x000002FFu; // NOP
+            if (below(3u) == 0u)
+            {
+                uint32_t special = below(0x31u);
+                if (special == 0x2Bu)
+                    special = 0x1Fu;
+                return (fields & ~0x7C0u) | 0x3Cu | (special & 3u) | ((special >> 2) << 6);
+            }
+            return fields | below(0x30u);
+        }
+
+        uint32_t lower()
+        {
+            const uint32_t fields = static_cast<uint32_t>(next()) & 0x01FFFFFFu;
+            const uint32_t kind = below(20u);
+            if (kind == 0u)
+                return 0x8000033Cu;
+            if (kind < 8u)
+            {
+                // Loads, stores, IADDIU/ISUBIU and the flag ops.
+                static constexpr uint8_t ops[] = {0x00, 0x01, 0x04, 0x05, 0x08, 0x09, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15,
+                                                  0x16, 0x17, 0x18, 0x1A, 0x1B, 0x1C, 0x00, 0x01, 0x08, 0x09, 0x08};
+                return (static_cast<uint32_t>(ops[below(sizeof(ops))]) << 25) | fields;
+            }
+            if (kind == 8u)
+            {
+                // Short branches, forward or back.
+                static constexpr uint8_t ops[] = {0x20, 0x21, 0x28, 0x29, 0x2C, 0x2D, 0x2E, 0x2F};
+                const uint32_t offset = static_cast<uint32_t>(static_cast<int32_t>(below(9u)) - 3) & 0x7FFu;
+                return (static_cast<uint32_t>(ops[below(sizeof(ops))]) << 25) | (fields & 0x01FFF800u) | offset;
+            }
+            if (kind < 13u)
+            {
+                static constexpr uint8_t functs[] = {0x30, 0x31, 0x32, 0x34, 0x35};
+                return 0x80000000u | (fields & ~0x3Fu) | functs[below(sizeof(functs))];
+            }
+            // Moves, Q, P, R and VI ops, and XGKICK (0x6C) three times as often.
+            static constexpr uint8_t specials[] = {0x30, 0x31, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x3A, 0x3B, 0x3C,
+                                                   0x3D, 0x3E, 0x3F, 0x40, 0x41, 0x42, 0x43, 0x64, 0x68, 0x69, 0x70,
+                                                   0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7A, 0x7B,
+                                                   0x7C, 0x7D, 0x30, 0x31, 0x3C, 0x3D, 0x6C, 0x6C, 0x6C};
+            const uint32_t special = specials[below(sizeof(specials))];
+            return 0x80000000u | (fields & ~0x7FFu) | 0x3Cu | (special & 3u) | ((special >> 2) << 6);
+        }
+
+        // A program ending in an E bit, VU memory with GIF tags where small VI
+        // values point when gifTags is set, and random registers.
+        void setUp(PS2Memory &mem, uint8_t *code, uint8_t *data, VU1State &vu, bool gifTags)
+        {
+            std::memset(code, 0, PS2_VU1_CODE_SIZE);
+            const uint32_t pairs = 4u + below(28u);
+            for (uint32_t pair = 0; pair < pairs; ++pair)
+            {
+                uint32_t up = upper();
+                uint32_t low = lower();
+                if (below(24u) == 0u)
+                {
+                    up |= 0x80000000u; // I bit: the lower word is a float
+                    low = floatBits();
+                }
+                if (pair == pairs - 1u)
+                    up |= 0x40000000u;
+                std::memcpy(code + pair * 8u, &low, sizeof(low));
+                std::memcpy(code + pair * 8u + 4u, &up, sizeof(up));
+            }
+            mem.markVU1CodeModified();
+            for (uint32_t offset = 0; offset < PS2_VU1_DATA_SIZE; offset += 4u)
+            {
+                const uint32_t value = below(4u) == 0u ? floatBits() : static_cast<uint32_t>(next());
+                std::memcpy(data + offset, &value, sizeof(value));
+            }
+            if (gifTags)
+            {
+                for (uint32_t qword = 0; qword < 64u; ++qword)
+                {
+                    if (below(3u) == 0u)
+                        continue;
+                    const uint64_t nloop = 1u + below(6u);
+                    const uint64_t eop = below(3u) == 0u ? 1u : 0u;
+                    const uint64_t format = below(4u) == 0u ? 2u : 0u;
+                    const uint64_t nreg = 1u + below(3u);
+                    const uint64_t tag = nloop | (eop << 15) | (format << 58) | (nreg << 60);
+                    std::memcpy(data + qword * 16u, &tag, sizeof(tag));
+                }
+            }
+            for (uint32_t reg = 1; reg < 32u; ++reg)
+            {
+                for (uint32_t component = 0; component < 4u; ++component)
+                {
+                    const uint32_t bits = floatBits();
+                    std::memcpy(&vu.vf[reg][component], &bits, sizeof(bits));
+                }
+            }
+            for (uint32_t reg = 1; reg < 16u; ++reg)
+                vu.vi[reg] = static_cast<int16_t>(below(4u) == 0u ? static_cast<int32_t>(next())
+                                                                   : static_cast<int32_t>(below(64u)) - 8);
+            for (uint32_t component = 0; component < 4u; ++component)
+            {
+                const uint32_t bits = floatBits();
+                std::memcpy(&vu.acc[component], &bits, sizeof(bits));
+            }
+            uint32_t bits = floatBits();
+            std::memcpy(&vu.q, &bits, sizeof(bits));
+            bits = floatBits();
+            std::memcpy(&vu.i, &bits, sizeof(bits));
+            bits = floatBits();
+            std::memcpy(&vu.p, &bits, sizeof(bits));
+            vu.r = static_cast<uint32_t>(next());
+            vu.mac = below(2u) ? 0u : static_cast<uint32_t>(next()) & 0xFFFFu;
+            vu.status = below(2u) ? 0u : static_cast<uint32_t>(next()) & 0xFFFu;
+            vu.clip = below(2u) ? 0u : static_cast<uint32_t>(next()) & 0xFFFFFFu;
+        }
+    };
+
+    inline constexpr uint32_t kPrograms = 3000;
+    // The first programs, whose blocks the test build generates code for.
+    inline constexpr uint32_t kGeneratedPrograms = 100;
+
+    // Runs one program: small budgets stop some part way, and they resume.
+    inline void runProgram(VU1Interpreter &vu, PS2Memory &mem, GS &gs, uint8_t *code, uint8_t *data, uint32_t program)
+    {
+        VuFuzzer fuzzer{0x5EEDull * 0x1000003ull + program};
+        // Most get valid GIF tags; the rest send random data, which is mostly
+        // bad tags that stop the program.
+        fuzzer.setUp(mem, code, data, vu.state(), (program & 3u) != 0u);
+        const uint32_t budget = fuzzer.below(3u) == 0u ? 3u + fuzzer.below(40u) : 4000u;
+        const uint64_t startCycle = vu.state().cycles;
+        vu.execute(code, PS2_VU1_CODE_SIZE, data, PS2_VU1_DATA_SIZE, gs, &mem, 0u, 0x100u, 0x200u, budget);
+        for (uint32_t again = 0; again < 3u && !vu.state().ebit && vu.state().cycles - startCycle < 4000u; ++again)
+            vu.resume(code, PS2_VU1_CODE_SIZE, data, PS2_VU1_DATA_SIZE, gs, &mem, 0x100u, 0x200u,
+                      3u + fuzzer.below(400u));
+    }
+}
