+
+bool VU1Interpreter::decodeCompiledFmac(uint32_t instr, CompiledFmac &out)
+{
+    const uint8_t op = static_cast<uint8_t>(instr & 0x3Fu);
+    const bool toAcc = op >= 0x3Cu;
+    const uint8_t code = toAcc ? static_cast<uint8_t>((instr & 3u) | ((instr >> 4) & 0x7Cu)) : op;
+    CompiledFmac result;
+    if (code <= 0x0Fu || (code >= 0x18u && code <= 0x1Bu))
+    {
+        result.form = code <= 0x03u ? 0u : code <= 0x07u ? 1u : code <= 0x0Bu ? 3u : code <= 0x0Fu ? 4u : 2u;
+        result.rhs = static_cast<uint8_t>(code & 3u);
+    }
+    else if (code >= 0x1Cu && code <= 0x27u && (code == 0x1Cu || code == 0x1Eu || code >= 0x20u))
+    {
+        static constexpr uint8_t forms[12] = {2, 2, 2, 2, 0, 3, 0, 3, 1, 4, 1, 4};
+        result.form = forms[code - 0x1Cu];
+        const bool usesI = code == 0x1Eu || (code >= 0x20u && (code & 2u) != 0u);
+        result.rhs = usesI ? 4u : 5u;
+    }
+    else if (code == 0x28u || code == 0x29u || code == 0x2Au || code == 0x2Cu || code == 0x2Du)
+    {
+        result.form = code == 0x28u ? 0u : code == 0x29u ? 3u : code == 0x2Au ? 2u : code == 0x2Cu ? 1u : 4u;
+        result.rhs = 6u;
+    }
+    else if (code == 0x2Eu && (DEST(instr) & 0x1u) == 0u)
+    {
+        result.form = toAcc ? 2u : 4u;
+        result.rhs = 7u;
+    }
+    else
+        return false;
+    if (DEST(instr) == 0u)
+        return false;
+    result.fs = FS(instr);
+    result.ft = FT(instr);
+    result.fd = FD(instr);
+    result.components = kReverseLanes[DEST(instr)];
+    result.toAcc = toAcc;
+    out = result;
+    return true;
+}
+
+// Games switch between a few code images and upload them again often (each
+// VIF MPG counts as a change), so blocks are kept per image, found by content.
+struct VU1Interpreter::CompiledCache
+{
+    static constexpr size_t kMaxImages = 8;
+    std::vector<std::unique_ptr<CompiledCode>> images;
+    CompiledCode *current = nullptr;
+    const uint8_t *code = nullptr;
+    uint32_t codeSize = 0;
+    uint64_t generation = 0;
+    uint64_t switches = 0;
+};
+
+// The interpreter's decoded pairs are only rebuilt for a new image: a known
+// one keeps its own copy, and run() rebuilds them if it takes over.
+VU1Interpreter::CompiledCode *VU1Interpreter::compiledCodeFor(const uint8_t *vuCode, uint32_t codeSize,
+                                                              PS2Memory *memory)
+{
+    if (!m_compiled)
+        m_compiled = std::make_shared<CompiledCache>();
+    CompiledCache &cache = *m_compiled;
+    const uint64_t generation = memory->getVU1CodeGeneration();
+    if (cache.current && cache.code == vuCode && cache.codeSize == codeSize && cache.generation == generation)
+        return cache.current;
+
+    CompiledCode *found = nullptr;
+    for (const std::unique_ptr<CompiledCode> &image : cache.images)
+    {
+        if (image->image.size() == codeSize && std::memcmp(image->image.data(), vuCode, codeSize) == 0)
+        {
+            found = image.get();
+            break;
+        }
+    }
+    if (!found)
+    {
+        const DecodedInstructionPair *decodedCode = decodedCodeFor(vuCode, codeSize, memory);
+        if (!decodedCode)
+            return nullptr;
+        if (cache.images.size() == CompiledCache::kMaxImages)
+        {
+            const auto oldest = std::min_element(cache.images.begin(), cache.images.end(),
+                                                 [](const auto &a, const auto &b) { return a->lastUse < b->lastUse; });
+            cache.images.erase(oldest);
+        }
+        auto image = std::make_unique<CompiledCode>();
+        image->image.assign(vuCode, vuCode + codeSize);
+        image->decoded.assign(decodedCode, decodedCode + std::min<uint32_t>(codeSize / 8u, kMaxDecodedPairs));
+        image->intern(VuTiming{});
+        found = image.get();
+        cache.images.push_back(std::move(image));
+    }
+    found->lastUse = ++cache.switches;
+    cache.current = found;
+    cache.code = vuCode;
+    cache.codeSize = codeSize;
+    cache.generation = generation;
+    return found;
+}
+
+namespace
+{
+    const VU1GeneratedBlock *g_generatedBlocks = nullptr;
+    size_t g_generatedBlockCount = 0;
+    // Set while generate compiles candidates, which aren't blocks a run used.
+    bool g_generating = false;
+
+    // Block list lines: the start pc (bit 16 for a delay slot) and code hash
+    // in hex, then the entry timing's nonzero bytes as byte:value pairs, or
+    // "-" when it has none.
+    struct ListedBlock
+    {
+        uint32_t pc = 0;
+        uint64_t code = 0;
+        VuTiming timing;
+    };
+
+    bool parseListedBlock(const char *line, ListedBlock &out)
+    {
+        unsigned pc = 0;
+        unsigned long long code = 0;
+        int used = 0;
+        if (std::sscanf(line, "%x %llx %n", &pc, &code, &used) != 2 || used == 0)
+            return false;
+        out = ListedBlock{pc, code, VuTiming{}};
+        const char *rest = line + used;
+        if (*rest == '-')
+            return true;
+        auto *bytes = reinterpret_cast<uint8_t *>(&out.timing);
+        while (true)
+        {
+            unsigned index = 0, value = 0;
+            int length = 0;
+            if (std::sscanf(rest, "%u:%u%n", &index, &value, &length) != 2 || index >= sizeof(VuTiming) ||
+                value > 0xFFu)
+                return false;
+            bytes[index] = static_cast<uint8_t>(value);
+            rest += length;
+            if (*rest != ',')
+                return true;
+            ++rest;
+        }
+    }
+
+    using ListedKey = std::tuple<uint64_t, uint32_t, uint64_t>; // code, pc, timingKey
+}
+
+void registerGeneratedBlocks(const VU1GeneratedBlock *blocks, size_t count)
+{
+    g_generatedBlocks = blocks;
+    g_generatedBlockCount = count;
+}
+
+size_t generatedBlockCount() { return g_generatedBlockCount; }
+
+GeneratedBlockFn findGeneratedBlock(uint64_t code, uint32_t pc, uint64_t timing)
+{
+    struct KeyHash
+    {
+        size_t operator()(const ListedKey &key) const
+        {
+            return static_cast<size_t>(std::get<0>(key) ^ (std::get<2>(key) * 31u) ^ std::get<1>(key));
+        }
+    };
+    // PS2X_VU1_GENERATED=0 runs every block in the executor.
+    static const std::unordered_map<ListedKey, GeneratedBlockFn, KeyHash> table = []
+    {
+        std::unordered_map<ListedKey, GeneratedBlockFn, KeyHash> map;
+        const char *enabled = std::getenv("PS2X_VU1_GENERATED");
+        if (enabled && std::strcmp(enabled, "0") == 0)
+            return map;
+        for (size_t i = 0; i < g_generatedBlockCount; ++i)
+            map.emplace(ListedKey{g_generatedBlocks[i].code, g_generatedBlocks[i].pc, g_generatedBlocks[i].timing},
+                        g_generatedBlocks[i].run);
+        return map;
+    }();
+    const auto found = table.find(ListedKey{code, pc, timing});
+    return found != table.end() ? found->second : nullptr;
+}
+
+void recordCompiledBlock(uint32_t pc, uint64_t code, const VuTiming &timing)
+{
+    static std::FILE *const list = []() -> std::FILE *
+    {
+        const char *path = std::getenv("PS2X_VU1_BLOCK_LIST");
+        return path && *path ? std::fopen(path, "a") : nullptr;
+    }();
+    if (!list || g_generating)
+        return;
+    static std::mutex mutex;
+    static std::set<ListedKey> written;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (!written.insert(ListedKey{code, pc, timingKey(timing)}).second)
+        return;
+    std::fprintf(list, "%x %016llx ", pc, static_cast<unsigned long long>(code));
+    const auto *bytes = reinterpret_cast<const uint8_t *>(&timing);
+    bool any = false;
+    for (size_t i = 0; i < sizeof(VuTiming); ++i)
+    {
+        if (bytes[i] == 0u)
+            continue;
+        std::fprintf(list, "%s%zu:%u", any ? "," : "", i, bytes[i]);
+        any = true;
+    }
+    std::fprintf(list, "%s\n", any ? "" : "-");
+    // A run may end by being killed; keep what it found.
+    std::fflush(list);
+}
