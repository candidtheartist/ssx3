diff --git a/ps2xRuntime/src/lib/ps2_host_sync.cpp b/ps2xRuntime/src/lib/ps2_host_sync.cpp
new file mode 100644
index 0000000..d3f7a85
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_sync.cpp
@@ -0,0 +1,85 @@
+#include "runtime/ps2_host_sync.h"
+
+#include <cstdlib>
+#include <thread>
+
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+
+#if defined(__i386__) || defined(__x86_64__) || defined(_M_IX86) || defined(_M_X64)
+#include <immintrin.h>
+#endif
+
+namespace ps2_host_sync
+{
+#if defined(_WIN32)
+    static_assert(sizeof(SRWLOCK) == sizeof(void *) && sizeof(CONDITION_VARIABLE) == sizeof(void *),
+                  "SRWLOCK and CONDITION_VARIABLE are a pointer each, zero when unused");
+
+    void Mutex::lock()
+    {
+        AcquireSRWLockExclusive(reinterpret_cast<PSRWLOCK>(&m_lock));
+    }
+
+    bool Mutex::try_lock()
+    {
+        return TryAcquireSRWLockExclusive(reinterpret_cast<PSRWLOCK>(&m_lock)) != 0;
+    }
+
+    void Mutex::unlock()
+    {
+        ReleaseSRWLockExclusive(reinterpret_cast<PSRWLOCK>(&m_lock));
+    }
+
+    void CondVar::notify_one() noexcept
+    {
+        WakeConditionVariable(reinterpret_cast<PCONDITION_VARIABLE>(&m_cv));
+    }
+
+    void CondVar::notify_all() noexcept
+    {
+        WakeAllConditionVariable(reinterpret_cast<PCONDITION_VARIABLE>(&m_cv));
+    }
+
+    void CondVar::wait(std::unique_lock<Mutex> &lock)
+    {
+        SleepConditionVariableSRW(reinterpret_cast<PCONDITION_VARIABLE>(&m_cv),
+                                  reinterpret_cast<PSRWLOCK>(&lock.mutex()->m_lock), INFINITE, 0);
+    }
+
+    void CondVar::waitMs(std::unique_lock<Mutex> &lock, unsigned long ms)
+    {
+        if (ms == 0)
+        {
+            lock.unlock();
+            std::this_thread::yield();
+            lock.lock();
+            return;
+        }
+        SleepConditionVariableSRW(reinterpret_cast<PCONDITION_VARIABLE>(&m_cv),
+                                  reinterpret_cast<PSRWLOCK>(&lock.mutex()->m_lock), ms, 0);
+    }
+#endif
+
+    unsigned spinCount()
+    {
+        // About 20 microseconds on a current x86 core, near what waking a sleeping
+        // thread costs.
+        static const unsigned spins = []
+        {
+            const char *value = std::getenv("PS2X_GS_SPIN");
+            return value ? static_cast<unsigned>(std::strtoul(value, nullptr, 10)) : 2000u;
+        }();
+        return spins;
+    }
+
+    void spinPause()
+    {
+#if defined(__i386__) || defined(__x86_64__) || defined(_M_IX86) || defined(_M_X64)
+        _mm_pause();
+#else
+        std::this_thread::yield();
+#endif
+    }
+}
diff --git a/ps2xRuntime/src/lib/ps2_host_thread.cpp b/ps2xRuntime/src/lib/ps2_host_thread.cpp
new file mode 100644
index 0000000..d6561bb
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_thread.cpp
@@ -0,0 +1,73 @@
+#include "ps2_host_thread.h"
+
+#include <exception>
+#include <memory>
+#include <system_error>
+
+#if defined(_WIN32)
+#include <cerrno>
+#include <process.h>
+#include <windows.h>
+
+namespace
+{
+    unsigned __stdcall runBody(void *arg)
+    {
+        const std::unique_ptr<std::function<void()>> body(static_cast<std::function<void()> *>(arg));
+        (*body)();
+        return 0;
+    }
+}
+
+Ps2HostThread::Ps2HostThread(size_t stackBytes, std::function<void()> body)
+{
+    auto *heapBody = new std::function<void()>(std::move(body));
+    const uintptr_t handle = _beginthreadex(nullptr, static_cast<unsigned>(stackBytes), runBody, heapBody,
+                                            STACK_SIZE_PARAM_IS_A_RESERVATION, nullptr);
+    if (!handle)
+    {
+        delete heapBody;
+        throw std::system_error(errno, std::generic_category(), "cannot start a host thread");
+    }
+    m_handle = reinterpret_cast<void *>(handle);
+}
+
+Ps2HostThread::~Ps2HostThread()
+{
+    if (joinable())
+        std::terminate();
+}
+
+bool Ps2HostThread::joinable() const
+{
+    return m_handle != nullptr;
+}
+
+void Ps2HostThread::join()
+{
+    WaitForSingleObject(static_cast<HANDLE>(m_handle), INFINITE);
+    CloseHandle(static_cast<HANDLE>(m_handle));
+    m_handle = nullptr;
+}
+
+#else
+
+// pthreads' default stack (8 MB with glibc) is already enough, so stackBytes isn't used.
+Ps2HostThread::Ps2HostThread(size_t, std::function<void()> body)
+    : m_thread(std::move(body))
+{
+}
+
+Ps2HostThread::~Ps2HostThread() = default;
+
+bool Ps2HostThread::joinable() const
+{
+    return m_thread.joinable();
+}
+
+void Ps2HostThread::join()
+{
+    m_thread.join();
+}
+
+#endif
diff --git a/ps2xRuntime/src/lib/ps2_identity_map.cpp b/ps2xRuntime/src/lib/ps2_identity_map.cpp
new file mode 100644
index 0000000..e46a8ef
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_identity_map.cpp
@@ -0,0 +1,98 @@
+// Identity-mapped EE memory for 32-bit hosts (Linux).
+//
+// Main RAM is one shared-memory object with several views:
+//   - a full 32 MB view anywhere, handed to the runtime as rdram (it indexes
+//     rdram + (addr & PS2_RAM_MASK), so it needs the kernel area below 1 MB too);
+//   - views at the PS2 addresses 0x00100000, 0x20100000 and 0x30100000, so a
+//     guest pointer is also a valid host pointer for natively compiled C.
+// The scratchpad is mapped directly at 0x70000000.
+// The views are made in a constructor, before libraries start taking address space.
+
+#if defined(__linux__) && !defined(__x86_64__)
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace
+{
+    constexpr uint32_t kRamSize = 0x02000000u;
+    constexpr uint32_t kUserBase = 0x00100000u;
+    constexpr uint32_t kMirrors[] = {0x00000000u, 0x20000000u, 0x30000000u};
+    constexpr uint32_t kSprBase = 0x70000000u;
+    constexpr uint32_t kSprSize = 0x4000u;
+
+    int g_fd = -1;
+    uint8_t *g_rdram = nullptr;
+    uint8_t *g_spr = nullptr;
+
+    bool mapFixed(uint32_t addr, size_t size, int prot, int flags, int fd, off_t off)
+    {
+        void *want = reinterpret_cast<void *>(static_cast<uintptr_t>(addr));
+        void *got = mmap(want, size, prot, flags | MAP_FIXED_NOREPLACE, fd, off);
+        if (got == MAP_FAILED)
+            return false;
+        if (got != want)
+        {
+            munmap(got, size);
+            return false;
+        }
+        return true;
+    }
+
+    __attribute__((constructor(101))) void ps2xMapEeMemory()
+    {
+        g_fd = memfd_create("ps2x-ee-ram", MFD_CLOEXEC);
+        if (g_fd < 0 || ftruncate(g_fd, kRamSize) != 0)
+        {
+            std::perror("ps2x: EE RAM memfd");
+            std::abort();
+        }
+        void *full = mmap(nullptr, kRamSize, PROT_READ | PROT_WRITE, MAP_SHARED, g_fd, 0);
+        if (full == MAP_FAILED)
+        {
+            std::perror("ps2x: EE RAM view");
+            std::abort();
+        }
+        g_rdram = static_cast<uint8_t *>(full);
+        for (uint32_t base : kMirrors)
+        {
+            if (!mapFixed(base + kUserBase, kRamSize - kUserBase, PROT_READ | PROT_WRITE, MAP_SHARED, g_fd, kUserBase))
+            {
+                std::fprintf(stderr, "ps2x: cannot map EE RAM at 0x%08x\n", base + kUserBase);
+                std::abort();
+            }
+        }
+        if (!mapFixed(kSprBase, kSprSize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0))
+        {
+            std::fprintf(stderr, "ps2x: cannot map scratchpad at 0x%08x\n", kSprBase);
+            std::abort();
+        }
+        g_spr = reinterpret_cast<uint8_t *>(static_cast<uintptr_t>(kSprBase));
+    }
+}
+
+extern "C" uint8_t *ps2x_host_map_rdram(size_t size)
+{
+    return size == kRamSize ? g_rdram : nullptr;
+}
+
+extern "C" void ps2x_host_unmap_rdram(uint8_t *)
+{
+    // The views live for the whole process.
+}
+
+extern "C" uint8_t *ps2x_host_map_scratchpad(size_t size)
+{
+    return size == kSprSize ? g_spr : nullptr;
+}
+
+extern "C" void ps2x_host_unmap_scratchpad(uint8_t *)
+{
+}
+
+#endif
