+// Generates C++ for the VU1 blocks a block list names, from the VU1 programs
+// in the game's ELF, so the runtime can run them as straight-line code instead
+// of stepping through the executor's pair list.
+//
+// usage: ps2_vu1_blockgen ELF BLOCK_LIST OUT_PREFIX SHARDS [SECTION...]
+//
+// The block list comes from playing the game with PS2X_VU1_BLOCK_LIST set and
+// holds only numbers; the VU1 code comes from the ELF at build time, so the
+// generated files are build output and never belong in a repository. The VU1
+// programs are the VIF MPG packets in SECTION (default .vutext): each run of
+// packets that starts at address 0 is taken as one program image. Blocks no
+// image holds are left to the executor.
+
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+#include "vu/ps2_vu1_compiled.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+namespace
+{
+    uint32_t read32(const std::vector<uint8_t> &bytes, size_t offset)
+    {
+        uint32_t value = 0;
+        if (offset + 4u <= bytes.size())
+            std::memcpy(&value, bytes.data() + offset, 4);
+        return value;
+    }
+
+    uint16_t read16(const std::vector<uint8_t> &bytes, size_t offset)
+    {
+        uint16_t value = 0;
+        if (offset + 2u <= bytes.size())
+            std::memcpy(&value, bytes.data() + offset, 2);
+        return value;
+    }
+
+    struct Section
+    {
+        uint32_t address = 0;
+        uint32_t offset = 0;
+        uint32_t size = 0;
+    };
+
+    // The sections of a little-endian ELF32 with one of the given names.
+    bool findSections(const std::vector<uint8_t> &elf, const std::vector<std::string> &names,
+                      std::vector<Section> &sections)
+    {
+        if (elf.size() < 0x34u || std::memcmp(elf.data(), "\x7F" "ELF", 4) != 0 || elf[4] != 1u || elf[5] != 1u)
+            return false;
+        const uint32_t headers = read32(elf, 0x20);
+        const uint16_t headerSize = read16(elf, 0x2E);
+        const uint16_t count = read16(elf, 0x30);
+        const uint16_t namesIndex = read16(elf, 0x32);
+        if (headerSize < 0x28u || namesIndex >= count ||
+            static_cast<uint64_t>(headers) + static_cast<uint64_t>(count) * headerSize > elf.size())
+            return false;
+        const uint32_t namesOffset = read32(elf, headers + namesIndex * headerSize + 0x10);
+        for (uint16_t i = 0; i < count; ++i)
+        {
+            const size_t header = headers + static_cast<size_t>(i) * headerSize;
+            const uint32_t nameOffset = namesOffset + read32(elf, header);
+            if (nameOffset >= elf.size())
+                continue;
+            const char *name = reinterpret_cast<const char *>(elf.data() + nameOffset);
+            const size_t nameLength = strnlen(name, elf.size() - nameOffset);
+            const Section section{read32(elf, header + 0x0C), read32(elf, header + 0x10), read32(elf, header + 0x14)};
+            const bool hasBits = read32(elf, header + 0x04) != 8u; // not SHT_NOBITS
+            for (const std::string &wanted : names)
+            {
+                if (hasBits && wanted.size() == nameLength && wanted.compare(0, nameLength, name, nameLength) == 0 &&
+                    static_cast<uint64_t>(section.offset) + section.size <= elf.size())
+                    sections.push_back(section);
+            }
+        }
+        return true;
+    }
+
+    // VU1 program images from the VIF MPG packets in a section. An MPG code
+    // is followed by its pairs from the next 64-bit boundary.
+    void addImages(const std::vector<uint8_t> &elf, const Section &section, std::vector<std::vector<uint8_t>> &images)
+    {
+        std::vector<uint8_t> *image = nullptr;
+        for (uint32_t offset = 0; offset + 4u <= section.size; offset += 4u)
+        {
+            const uint32_t code = read32(elf, section.offset + offset);
+            if (((code >> 24) & 0x7Fu) != 0x4Au)
+                continue;
+            const uint32_t pairs = ((code >> 16) & 0xFFu) != 0u ? (code >> 16) & 0xFFu : 256u;
+            const uint32_t address = (code & 0xFFFFu) * 8u;
+            uint32_t data = offset + 4u;
+            if (((section.address + data) & 7u) != 0u)
+                data += 4u;
+            if (static_cast<uint64_t>(data) + pairs * 8u > section.size || address + pairs * 8u > PS2_VU1_CODE_SIZE)
+                continue;
+            if (address == 0u || !image)
+            {
+                images.emplace_back(PS2_VU1_CODE_SIZE, 0u);
+                image = &images.back();
+            }
+            std::memcpy(image->data() + address, elf.data() + section.offset + data, pairs * 8u);
+        }
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 5)
+    {
+        std::fprintf(stderr, "usage: %s ELF BLOCK_LIST OUT_PREFIX SHARDS [SECTION...]\n", argv[0]);
+        return 2;
+    }
+    std::ifstream elfFile(argv[1], std::ios::binary);
+    const std::vector<uint8_t> elf((std::istreambuf_iterator<char>(elfFile)), std::istreambuf_iterator<char>());
+    std::vector<std::string> names;
+    for (int i = 5; i < argc; ++i)
+        names.emplace_back(argv[i]);
+    if (names.empty())
+        names.emplace_back(".vutext");
+    std::vector<Section> sections;
+    if (!findSections(elf, names, sections))
+    {
+        std::fprintf(stderr, "%s: not a little-endian ELF32 file\n", argv[1]);
+        return 1;
+    }
+    std::vector<std::vector<uint8_t>> images;
+    for (const Section &section : sections)
+        addImages(elf, section, images);
+
+    std::FILE *list = std::fopen(argv[2], "r");
+    if (!list)
+    {
+        std::fprintf(stderr, "can't read %s\n", argv[2]);
+        return 1;
+    }
+    const int shardCount = std::atoi(argv[4]);
+    if (shardCount < 1)
+        return 2;
+    std::vector<std::FILE *> shards;
+    for (int i = 0; i < shardCount; ++i)
+    {
+        const std::string path = std::string(argv[3]) + std::to_string(i) + ".cpp";
+        shards.push_back(std::fopen(path.c_str(), "w"));
+        if (!shards.back())
+        {
+            std::fprintf(stderr, "can't write %s\n", path.c_str());
+            return 1;
+        }
+    }
+    size_t listed = 0;
+    const size_t written = VU1CompiledAccess::generate(images, list, shards, listed);
+    std::fclose(list);
+    for (std::FILE *shard : shards)
+        std::fclose(shard);
+    std::printf("VU1 blocks: %zu program images, %zu of %zu listed blocks generated\n", images.size(), written, listed);
+    return 0;
+}
