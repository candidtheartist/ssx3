+        const __m128d absHi = _mm_andnot_pd(signBit, hi);
+        const __m128d normalLo = _mm_and_pd(_mm_cmpge_pd(absLo, minimum), _mm_cmplt_pd(absLo, maximum));
+        const __m128d normalHi = _mm_and_pd(_mm_cmpge_pd(absHi, minimum), _mm_cmplt_pd(absHi, maximum));
+        return static_cast<uint32_t>(_mm_movemask_pd(normalLo) | (_mm_movemask_pd(normalHi) << 2));
